{{- /*
  Colorblind-safe (blue=added, orange=removed) workbench.colorCustomizations
  CONTENT ONLY -- no outer "workbench.colorCustomizations": { ... } wrapper,
  no leading or trailing comma. Code/Antigravity/Cursor already define that
  key (flat, unscoped) in vscode-fork-common.tmpl; a second top-level
  "workbench.colorCustomizations" key in the same object would silently lose
  one or the other on parse (JSON keeps the LAST duplicate key -- caught by
  rendering + parsing each target and diffing the parsed objects, exactly the
  check the koopa-chezmoi-dotfiles skill recommends). So this partial emits
  bare content and each caller splices it into whichever
  "workbench.colorCustomizations" object already exists for that app (or, for
  Positron, which has none, opens one):

    "workbench.colorCustomizations": {
      "some.existing.key": "...",
{{ includeTemplate "dracula-pro-diff-colors.tmpl" . | trimAll "\n" }}
    },

  Call with `.` (the root context) -- only needs .chezmoi.homeDir /
  env "XDG_CONFIG_HOME". No per-app glob detection needed (unlike
  dracula-pro-theme.tmpl, which must pick a THEME NAME per app): these keys
  are theme-scoped, and VS Code silently no-ops any scope that doesn't match
  an installed/active theme, so gating on the generated file's own existence
  (itself downstream of the shared Dracula Pro source, checked in
  _configure_dracula_pro_post) is sufficient regardless of which app is
  rendering.

  Values are generated by _generate_vscode_diff_colorcustomizations() in
  opt/dotfiles/install from the real Dracula Pro palette (contrast-verified,
  see that function's docstring); the else-branch below is the only place
  with literal hex, and only the free/allowlisted Dracula OSS colors (see
  rules/theme-colors.md). Alpha suffixes (20/40/80) match the vendor .vsix's
  own theme JSON exactly. gitDecoration.deletedResourceForeground uses cyan,
  not orange: orange is reserved for "modified" (matches the vendor default
  there, untouched), and modified/deleted co-occur in the same Source
  Control view.
*/ -}}
{{- $diffColors := joinPath (env "XDG_CONFIG_HOME" | default (joinPath .chezmoi.homeDir ".config")) "koopa" "vscode-diff-colors.json" -}}
{{- if stat $diffColors }}
{{ include $diffColors }}
{{- else }}
    "[Dracula Theme]": {
      "diffEditor.insertedLineBackground": "#bd93f920",
      "diffEditor.removedLineBackground": "#ffb86c20",
      "diffEditor.insertedTextBackground": "#bd93f940",
      "diffEditor.removedTextBackground": "#ffb86c40",
      "diffEditorGutter.insertedLineBackground": "#bd93f980",
      "diffEditorGutter.removedLineBackground": "#ffb86c80",
      "editorGutter.addedBackground": "#bd93f980",
      "editorGutter.deletedBackground": "#ffb86c80",
      "scmGraph.historyItemHoverAdditionsForeground": "#bd93f9",
      "scmGraph.historyItemHoverDeletionsForeground": "#ffb86c",
      "gitDecoration.addedResourceForeground": "#bd93f9",
      "gitDecoration.deletedResourceForeground": "#8be9fd"
    },
    "[Atom One Light]": {
      "diffEditor.insertedLineBackground": "#bd93f920",
      "diffEditor.removedLineBackground": "#ffb86c20",
      "diffEditor.insertedTextBackground": "#bd93f940",
      "diffEditor.removedTextBackground": "#ffb86c40",
      "diffEditorGutter.insertedLineBackground": "#bd93f980",
      "diffEditorGutter.removedLineBackground": "#ffb86c80",
      "editorGutter.addedBackground": "#bd93f980",
      "editorGutter.deletedBackground": "#ffb86c80",
      "scmGraph.historyItemHoverAdditionsForeground": "#bd93f9",
      "scmGraph.historyItemHoverDeletionsForeground": "#ffb86c",
      "gitDecoration.addedResourceForeground": "#bd93f9",
      "gitDecoration.deletedResourceForeground": "#8be9fd"
    }
{{- end -}}
