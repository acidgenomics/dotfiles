{{- /*
  Positron's own settings.json body (deltas plus shared partials). Positron
  is structured differently from Code/Antigravity/Cursor by design and does
  not call vscode-fork-common.tmpl — see the koopa-vscode skill. Called by
  dot_config/Positron/User/settings.json.tmpl through
  `fromJson | toPrettyJson`, which parses this partial's JSON output and
  re-emits it 2-space indented with keys sorted. Call with `.` (the root
  context) — this partial uses .chezmoi.homeDir and .chezmoi.os.
*/}}
{
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.detectIndentation": false,
    "editor.tabSize": 2
  },
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports.ruff": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.formatOnType": false
  },
  "[r]": {
{{- if lookPath "air" }}
    "editor.defaultFormatter": "Posit.air-vscode",
{{- end }}
    "editor.formatOnSave": true
  },
  "[toml]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 2
  },
  "editor.autoClosingComments": "never",
  "editor.autoClosingDelete": "never",
  "editor.autoClosingOvertype": "never",
  "editor.autoSurround": "never",
  "editor.codeLens": false,
  "editor.pasteAs.enabled": false,
  "files.associations": {
    "renv.lock": "json"
  },
{{- if lookPath "git" }}
  "git.path": "{{ lookPath "git" }}",
{{- end }}
{{- if lookPath "conda" }}
  "python.condaPath": "{{ lookPath "conda" }}",
{{- end }}
{{- if stat (joinPath .chezmoi.homeDir ".venv" "bin" "python3") }}
  "python.defaultInterpreterPath": "{{ .chezmoi.homeDir }}/.venv/bin/python3",
{{- end }}
{{- if lookPath "quarto" }}
  "quarto.path": "{{ lookPath "quarto" }}",
{{- end }}
  "workbench.editor.empty.hint": "hidden",
  "workbench.keybindings.rstudioKeybindings": true,
{{ includeTemplate "dracula-pro-theme.tmpl" (list (joinPath .chezmoi.homeDir ".positron" "extensions" "dracula-theme-pro.theme-dracula-pro-*") (joinPath .chezmoi.homeDir ".vscode" "extensions" "dracula-theme-pro.theme-dracula-pro-*")) | trimAll "\n" }}
  "workbench.colorCustomizations": {
{{ includeTemplate "dracula-pro-diff-colors.tmpl" . | trimAll "\n" }}
  },
{{ includeTemplate "vscode-universal-common.tmpl" . | trimAll "\n" }}
  "window.autoDetectColorScheme": true
}
