{{- /*
  Settings verified byte-identical across all four VS Code-family apps
  (Code, Antigravity, Cursor, Positron). Call with `. ` (the root context) —
  this partial does not use it today, but keeping the call signature
  consistent with vscode-fork-common.tmpl avoids surprises if a future
  addition needs .chezmoi.* here.
*/}}
  "editor.autoClosingBrackets": "never",
  "editor.autoClosingQuotes": "never",
  "editor.fontFamily": "'JetBrainsMonoNL NFM', 'JetBrains Mono', monospace",
  "editor.fontLigatures": false,
  "editor.fontSize": 16,
  "editor.minimap.enabled": false,
  "editor.rulers": [
    80
  ],
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 80,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "extensions.ignoreRecommendations": true,
  "files.defaultLanguage": "markdown",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.mypy_cache/**": true,
    "**/.pytest_tmp/**": true,
    "**/.ruff_cache/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/node_modules/**": true
  },
  "python.analysis.autoSearchPaths": false,
  "python.experiments.enabled": false,
  "redhat.telemetry.enabled": false,
  "search.followSymlinks": false,
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.defaultProfile.linux": "bash",
{{- if eq .chezmoi.os "darwin" }}
  "terminal.integrated.defaultProfile.osx": "bash",
  "terminal.integrated.profiles.osx": {
    "bash": {
      "args": [
        "-il"
      ],
      "icon": "terminal-bash",
      "path": "{{ lookPath "bash" }}"
    },
    "zsh": {
      "args": [
        "-il"
      ],
      "env": {
        "ZDOTDIR": "${env:HOME}/.config/zsh"
      },
      "icon": "terminal-bash",
      "path": "/bin/zsh"
    }
  },
{{- end }}
  "terminal.integrated.fontFamily": "'JetBrainsMonoNL NFM', 'JetBrains Mono', monospace",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.fontWeightBold": "bold",
  "terminal.integrated.inheritEnv": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.stickyScroll.enabled": false,
  "update.mode": "none",
  "update.showReleaseNotes": false,
  "workbench.startupEditor": "newUntitledFile",
