#!/usr/bin/env bash

# """
# Bash login shell configuration.
# Sources '~/.bashrc', which sources '~/.profile', so koopa activates once and
# login shells get the same post-activation settings as other interactive shells.
# Refer to '~/.profile' file for POSIX shell configuration details.
# """

__dotfiles_bash_profile() {
    case "${BASH_VERSION:-}" in
        '1.'* | '2.'* | '3.'*)
            return 0
            ;;
    esac
    [[ "$-" == *i* ]] || return 0
    if [[ -f "${HOME}/.bashrc" ]]
    then
        # shellcheck source=/dev/null
        source "${HOME}/.bashrc"
    fi
    return 0
}

__dotfiles_bash_profile
