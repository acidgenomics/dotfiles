{{- $dataHome := env "XDG_DATA_HOME" | default (joinPath .chezmoi.homeDir ".local/share") -}}
{{- $vimPalette := joinPath $dataHome "dracula-pro" "themes" "vim" "autoload" "dracula_pro.vim" -}}
{{- $koopaMarketplace := joinPath $dataHome "koopa" ".claude-plugin" "marketplace.json" -}}
{
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "autoUpdatesChannel": "latest",
  "spinnerTipsEnabled": false,
{{- if stat $vimPalette }}
  "theme": {{ if eq (env "KOOPA_COLOR_MODE") "light" }}"custom:dracula-pro-alucard"{{ else }}"custom:dracula-pro"{{ end }},
{{- else }}
  "theme": "auto",
{{- end }}
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "astral@astral-sh": true,
    "claude-code-setup@claude-plugins-official": true,
{{- if stat $koopaMarketplace }}
    "koopa@koopa": true,
{{- end }}
    "pyright-lsp@claude-plugins-official": true
  },
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_AUTOUPDATER": "1"
{{- if stat (joinPath $dataHome "ca-certificates" "cacert.pem") }},
    "AWS_CA_BUNDLE": "{{ $dataHome }}/ca-certificates/cacert.pem",
    "CURL_CA_BUNDLE": "{{ $dataHome }}/ca-certificates/cacert.pem",
    "DEFAULT_CA_BUNDLE_PATH": "{{ dir $dataHome }}",
    "REQUESTS_CA_BUNDLE": "{{ $dataHome }}/ca-certificates/cacert.pem",
    "SSL_CERT_FILE": "{{ $dataHome }}/ca-certificates/cacert.pem"
{{- else if and (eq .chezmoi.os "linux") (stat "/etc/ssl/certs/ca-certificates.crt") }},
    "AWS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
    "CURL_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
    "DEFAULT_CA_BUNDLE_PATH": "/etc/ssl/certs",
    "REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
    "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"
{{- end }}
  },
  "extensions": {
    "anthropic.claude-code": {
      "autoUpdate": false
    }
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
{{- if stat $koopaMarketplace }}
    "koopa": {
      "source": {
        "source": "directory",
        "path": "{{ joinPath $dataHome "koopa" }}"
      }
    },
{{- end }}
    "life-sciences": {
      "source": {
        "source": "github",
        "repo": "anthropics/life-sciences"
      }
    }
  },
  "model": "opusplan",
  "outputStyle": "STE100",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/guard-installs.sh" },
          { "type": "command", "command": "bash {{ .chezmoi.homeDir }}/.claude/hooks/guard-broad-scan.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(basename:*)",
      "Bash(cat:*)",
      "Bash(col:*)",
      "Bash(command -v:*)",
      "Bash(cut:*)",
      "Bash(diff:*)",
      "Bash(dirname:*)",
      "Bash(echo:*)",
      "Bash(env)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(man:*)",
      "Bash(otool:*)",
      "Bash(printenv:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(tr:*)",
      "Bash(type:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git check-ignore:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash list:*)",
      "Bash(git status:*)",
      "Bash(git worktree list:*)",
      "Bash(bash:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(sh:*)",
      "Bash(xargs:*)",
      "Edit(**)",
      "Edit(//**/*lessons.md)",
      "Grep",
      "ListMcpResourcesTool",
      "Python(*)",
      "Read(**)",
      "ReadMcpResourceTool",
      "mcp__ide__*",
      "mcp__mcp-atlassian__*",
      "mcp__read-website-fast__*",
      "mcp__tooluniverse__*"
    ],
    "defaultMode": "plan",
    "deny": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(rm -rf *)",
      "Edit(**/.env*)",
      "Edit(.env*)",
      "Read(**/.env*)",
      "Read(.env*)"
    ]
  },
  "plansDirectory": "./.claude/plans"
}
