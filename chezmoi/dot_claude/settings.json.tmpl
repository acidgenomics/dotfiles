{{- $dataHome := env "XDG_DATA_HOME" | default (joinPath .chezmoi.homeDir ".local/share") -}}
{{- $koopaPrefix := env "KOOPA_PREFIX" | default (joinPath $dataHome "koopa") -}}
{{- $vimPalette := joinPath $dataHome "dracula-pro" "themes" "vim" "autoload" "dracula-pro.vim" -}}
{{- $koopaMarketplace := joinPath $koopaPrefix ".claude-plugin" "marketplace.json" -}}
{{- /* CA bundle: koopa's bundle first, then the Linux system bundle. Computed
     once here so each env key below can sit in its sorted position. */}}
{{- $caBundle := "" -}}
{{- $caDir := "" -}}
{{- if stat (joinPath $dataHome "ca-certificates" "cacert.pem") -}}
{{-   $caBundle = joinPath $dataHome "ca-certificates" "cacert.pem" -}}
{{-   $caDir = joinPath $dataHome "ca-certificates" -}}
{{- else if and (eq .chezmoi.os "linux") (stat "/etc/ssl/certs/ca-certificates.crt") -}}
{{-   $caBundle = "/etc/ssl/certs/ca-certificates.crt" -}}
{{-   $caDir = "/etc/ssl/certs" -}}
{{- end -}}
{{- /* Keys are sorted alphabetically at every level, and the permission rule
     lists are sorted in byte order (LC_ALL=C sort, the same order as jq -S).
     Keep both sorted when you add a key or a rule. */}}
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
{{- if stat (joinPath .chezmoi.homeDir ".claude" "api-key") }}
  "apiKeyHelper": "cat \"$HOME/.claude/api-key\"",
{{- end }}
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "effortLevel": "high",
  "enabledPlugins": {
    "astral@astral-sh": true,
    "claude-code-setup@claude-plugins-official": false,
{{- if stat $koopaMarketplace }}
    "koopa@koopa": true,
{{- end }}
    "pyright-lsp@claude-plugins-official": false
  },
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
{{- if $caBundle }}
    "AWS_CA_BUNDLE": "{{ $caBundle }}",
{{- end }}
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SHELL": "{{ joinPath $koopaPrefix "bin" "bash" }}",
{{- if $caBundle }}
    "CURL_CA_BUNDLE": "{{ $caBundle }}",
    "DEFAULT_CA_BUNDLE_PATH": "{{ $caDir }}",
{{- end }}
    "DISABLE_UPDATES": "1"
{{- if $caBundle }},
    "REQUESTS_CA_BUNDLE": "{{ $caBundle }}",
    "SSL_CERT_FILE": "{{ $caBundle }}"
{{- end }}
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "repo": "anthropics/skills",
        "source": "github"
      }
    },
    "astral-sh": {
      "source": {
        "repo": "astral-sh/claude-code-plugins",
        "source": "github"
      }
    },
    "claude-plugins-official": {
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    },
{{- if stat $koopaMarketplace }}
    "koopa": {
      "source": {
        "path": "{{ $koopaPrefix }}",
        "source": "directory"
      }
    },
{{- end }}
    "life-sciences": {
      "source": {
        "repo": "anthropics/life-sciences",
        "source": "github"
      }
    }
  },
  "model": "sonnet",
  "outputStyle": "STE100",
  "permissions": {
    "allow": [
      "Bash(basename:*)",
      "Bash(cat:*)",
      "Bash(col:*)",
      "Bash(command -v:*)",
      "Bash(cut:*)",
      "Bash(diff:*)",
      "Bash(dirname:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(git -C * fetch*)",
      "Bash(git -C * show*)",
      "Bash(git blame:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a:*)",
      "Bash(git branch)",
      "Bash(git check-ignore:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote -v)",
      "Bash(git remote get-url:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash list:*)",
      "Bash(git status:*)",
      "Bash(git worktree list:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(man:*)",
      "Bash(otool:*)",
      "Bash(rg:*)",
      "Bash(sed -n:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(tr:*)",
      "Bash(type:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Edit(**)",
      "Grep",
      "ListMcpResourcesTool",
      "Read(**)",
      "ReadMcpResourceTool",
      "mcp__ide__*",
      "mcp__tooluniverse__*"
    ],
    "ask": [
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -fls*)",
      "Bash(find * -fprint*)",
      "Bash(find * -ok*)",
      "Bash(sed -i*)",
      "Bash(sort * -o*)",
      "Edit(~/.agents/hooks/**)"
    ],
    "defaultMode": "auto",
    {{/* Edit(~/.claude/settings.json): that file is rendered from this
         template, so a direct edit is lost on the next chezmoi apply. The
         rule blocks Edit and Write tool calls only. Claude Code's own writes
         (/model, "don't ask again" approvals) are not tool calls and still
         land; this template reverts them on apply. */}}
    "deny": [
      "Bash(cat *.env*)",
      "Bash(git -C * add*)",
      "Bash(git -C * commit*)",
      "Bash(git -C * merge*)",
      "Bash(git -C * push*)",
      "Bash(git -C * rebase*)",
      "Bash(git -C * reset*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Edit(**/.env*)",
      "Edit(.env*)",
      "Edit(~/.aws/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.config/chezmoi/age-key.txt)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.config/op/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/.env*)",
      "Read(.env*)",
      "Read(~/.aws/**)",
      "Read(~/.config/chezmoi/age-key.txt)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/op/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "plansDirectory": "./.claude/plans",
  "spinnerTipsEnabled": false,
{{- if stat $vimPalette }}
  "theme": "custom:dracula-pro-auto"
{{- else }}
  "theme": "auto"
{{- end }}
}
