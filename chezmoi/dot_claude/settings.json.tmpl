{{- $dataHome := env "XDG_DATA_HOME" | default (joinPath .chezmoi.homeDir ".local/share") -}}
{{- $koopaPrefix := env "KOOPA_PREFIX" | default (joinPath $dataHome "koopa") -}}
{{- $vimPalette := joinPath $dataHome "dracula-pro" "themes" "vim" "autoload" "dracula-pro.vim" -}}
{{- $koopaMarketplace := joinPath $koopaPrefix ".claude-plugin" "marketplace.json" -}}
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "autoUpdatesChannel": "latest",
  "spinnerTipsEnabled": false,
{{- if stat $vimPalette }}
  "theme": {{ if eq (env "KOOPA_COLOR_MODE") "light" }}"custom:dracula-pro-alucard"{{ else }}"custom:dracula-pro"{{ end }},
{{- else }}
  "theme": "auto",
{{- end }}
  "effortLevel": "high",
  "enabledPlugins": {
    "astral@astral-sh": true,
    "claude-code-setup@claude-plugins-official": false,
{{- if stat $koopaMarketplace }}
    "koopa@koopa": true,
{{- end }}
    "pyright-lsp@claude-plugins-official": false
  },
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SHELL": "{{ joinPath $koopaPrefix "bin" "bash" }}",
    "DISABLE_UPDATES": "1"
{{- if stat (joinPath $dataHome "ca-certificates" "cacert.pem") }},
    "AWS_CA_BUNDLE": "{{ $dataHome }}/ca-certificates/cacert.pem",
    "CURL_CA_BUNDLE": "{{ $dataHome }}/ca-certificates/cacert.pem",
    "DEFAULT_CA_BUNDLE_PATH": "{{ $dataHome }}/ca-certificates",
    "REQUESTS_CA_BUNDLE": "{{ $dataHome }}/ca-certificates/cacert.pem",
    "SSL_CERT_FILE": "{{ $dataHome }}/ca-certificates/cacert.pem"
{{- else if and (eq .chezmoi.os "linux") (stat "/etc/ssl/certs/ca-certificates.crt") }},
    "AWS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
    "CURL_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
    "DEFAULT_CA_BUNDLE_PATH": "/etc/ssl/certs",
    "REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
    "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"
{{- end }}
  },
  "extensions": {
    "anthropic.claude-code": {
      "autoUpdate": false
    }
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
{{- if stat $koopaMarketplace }}
    "koopa": {
      "source": {
        "source": "directory",
        "path": "{{ $koopaPrefix }}"
      }
    },
{{- end }}
    "life-sciences": {
      "source": {
        "source": "github",
        "repo": "anthropics/life-sciences"
      }
    }
  },
  "model": "sonnet",
  "outputStyle": "STE100",
  "permissions": {
    "allow": [
      "Bash(basename:*)",
      "Bash(cat:*)",
      "Bash(col:*)",
      "Bash(command -v:*)",
      "Bash(cut:*)",
      "Bash(diff:*)",
      "Bash(dirname:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(man:*)",
      "Bash(otool:*)",
      "Bash(rg:*)",
      "Bash(sed -n:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(tr:*)",
      "Bash(type:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(git blame:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a:*)",
      "Bash(git branch --list:*)",
      "Bash(git check-ignore:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote -v)",
      "Bash(git remote get-url:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash list:*)",
      "Bash(git status:*)",
      "Bash(git worktree list:*)",
      "Edit(**)",
      "Grep",
      "ListMcpResourcesTool",
      "Read(**)",
      "ReadMcpResourceTool",
      "mcp__ide__*",
      "mcp__tooluniverse__*"
    ],
    "ask": [
      "Edit(/{{ .chezmoi.homeDir }}/.agents/hooks/**)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -ok*)",
      "Bash(find * -fls*)",
      "Bash(find * -fprint*)",
      "Bash(sed -i*)",
      "Bash(sort * -o*)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git -C * add*)",
      "Bash(git -C * commit*)",
      "Bash(git -C * merge*)",
      "Bash(git -C * push*)",
      "Bash(git -C * rebase*)",
      "Bash(git -C * reset*)",
      "Bash(cat *.env*)",
      "Edit(**/.env*)",
      "Edit(.env*)",
      "Read(**/*.pem)",
      "Read(**/.env*)",
      "Read(.env*)",
      "Read(~/.aws/**)",
      "Read(~/.config/chezmoi/age-key.txt)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/op/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/chezmoi/age-key.txt)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.config/op/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.ssh/**)"
    ]
  },
  "plansDirectory": "./.claude/plans"
}
