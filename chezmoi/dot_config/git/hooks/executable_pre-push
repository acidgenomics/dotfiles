#!/bin/sh
# Global pre-push guard, run for every repo on this machine because
# core.hooksPath points here.
#
# 1. Corporate-identity check: refuse to push commits authored/committed
#    with a corporate identity to a remote not in the corporate allowlist.
#    No-op unless koopa.corp* config keys are set (set only by the private
#    config-corp file) -- on a non-corp machine this step is skipped.
# 2. Delegation: after the identity check passes, run the pushed repo's own
#    tracked .githooks/pre-push, if it has one. A global core.hooksPath
#    otherwise makes a repo-local pre-push hook permanently inert -- git
#    only ever reads hooks from the path core.hooksPath names.
#
# stdin (the pushed ref list) is read once into $refs and replayed to the
# delegated hook, since a POSIX shell can only consume stdin once.

remote_url="$2"
z=0000000000000000000000000000000000000000

refs=$(cat)

domains=$(git config --get-all koopa.corpEmailDomains)
allow=$(git config --get-all koopa.corpRemoteAllowlist)

if [ -n "$domains" ]
then
    # Is the destination remote permitted to receive corp-identity commits?
    remote_allowed=0
    for a in $allow
    do
        case "$remote_url" in
            *"$a"*) remote_allowed=1 ;;
        esac
    done

    # Build an alternation pattern for grep from the domain list.
    dpat=$(printf '%s' "$domains" | tr ' \n' '|' | sed 's/|*$//; s/\./\\./g')

    found_corp=0
    while read -r lref loid rref roid
    do
        [ -n "$loid" ] || continue
        [ "$loid" = "$z" ] && continue
        if [ "$roid" = "$z" ]
        then
            range="$loid --not --remotes"
        else
            range="$roid..$loid"
        fi
        if git log --format='%ae%n%ce' $range 2>/dev/null | grep -qiE "@($dpat)\$"
        then
            found_corp=1
        fi
    done <<EOF
$refs
EOF

    if [ "$found_corp" = 1 ] && [ "$remote_allowed" = 0 ]
    then
        echo "ERROR (koopa pre-push guard): refusing to push commits authored with a" >&2
        echo "  corporate identity ($domains) to a non-corporate remote:" >&2
        echo "    $remote_url" >&2
        echo "  Allowed corporate remotes must contain: $allow" >&2
        echo "  Fix author identity (git commit --amend --reset-author / git rebase)" >&2
        echo "  or push to an allowed remote." >&2
        exit 1
    fi
fi

# Delegate to the repo's own pre-push hook, if it ships one -- see point 2
# in the header comment above.
hook="$(git rev-parse --show-toplevel 2>/dev/null)/.githooks/pre-push"
if [ -x "$hook" ]
then
    printf '%s\n' "$refs" | "$hook" "$1" "$2" || exit 1
fi
exit 0
