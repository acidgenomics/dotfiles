# """
# ripgrep configuration.
# Updated 2026-09-02.
#
# @seealso
# - https://github.com/BurntSushi/ripgrep/blob/master/GUIDE.md
# - https://github.com/BurntSushi/ripgrep/blob/master/FAQ.md
# - RIPGREP_CONFIG_PATH
# """

# Usage of these will resemble 'grep -r'.
# > --binary
# > --hidden

# Can set regex engine with (instead of '--glob'):
# > --engine=default

# Can limit recursion with:
# > --max-depth=5

--case-sensitive
--color=always
{{ if eq (env "KOOPA_COLOR_MODE") "dark" -}}
--colors=match:fg:magenta
--colors=match:style:bold
--colors=line:fg:green
--colors=path:fg:cyan
{{ end -}}
--fixed-strings
--max-columns-preview
--max-columns=150
--max-filesize=10M
--no-follow
--one-file-system

# Do not add '--no-ignore' here. It disables .gitignore in every repo, so a bare
# 'rg' walks every ignored tree (measured at 702,003 files in the koopa prefix,
# versus 1,226 with .gitignore active). Use '-u'/'-uu'/'-uuu' per command instead.
