# """
# EditorConfig
#
# @note Updated 2026-08-04.
#
# @seealso
# - https://editorconfig.org
# - https://github.com/editorconfig/editorconfig/wiki/EditorConfig-Properties
# """

root=true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[Makefile]
indent_style = tab

[*.R]
indent_size = 4
indent_style = space
max_line_length = 80
tab_width = 4

[*.{sh,bash,zsh}]
indent_size = 4
indent_style = space
tab_width = 4

# Chezmoi source files carry filename prefixes/suffixes (dot_, private_,
# executable_, .tmpl) instead of a shell extension, so the section above
# cannot reach them.
[{install,dot_profile*,dot_bashrc*,dot_aliases*,dot_z*,executable_*}]
indent_size = 4
indent_style = space
tab_width = 4

[*.{Rmd,md}]
indent_size = 4
indent_style = space
max_line_length = 80
tab_width = 4
trim_trailing_whitespace = false

[*.{json,toml,yaml,yml}]
indent_size = 2
indent_style = space
tab_width = 2

[*.py]
indent_size = 4
indent_style = space
max_line_length = 80
tab_width = 4
