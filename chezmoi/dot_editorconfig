# """
# EditorConfig
#
# @note Updated 2026-10-16.
#
# @seealso
# - https://editorconfig.org
# - https://github.com/editorconfig/editorconfig/wiki/EditorConfig-Properties
# """

root=true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[Makefile]
indent_style = tab

[*.R]
indent_size = 4
indent_style = space
max_line_length = 80
tab_width = 4

[*.{sh,bash,zsh}]
indent_size = 4
indent_style = space
tab_width = 4

# Chezmoi source files carry filename prefixes/suffixes (dot_, private_,
# executable_, .tmpl) instead of a shell extension, so the section above
# cannot reach them.
[{install,dot_profile*,dot_bashrc*,dot_aliases*,dot_z*,executable_*}]
indent_size = 4
indent_style = space
tab_width = 4

# R Markdown follows the R code style: 4 spaces, no tabs, 80 columns. The
# Bioconductor guidelines set this for R code only. Applying it to R Markdown
# and Markdown is a deliberate choice, so these files match the R chunks they
# contain. Keep Prettier ('.prettierrc.json') and air ('air.toml') in sync.
# - https://contributions.bioconductor.org/r-code.html
[*.{Rmd,md}]
indent_size = 4
indent_style = space
max_line_length = 80
tab_width = 4
trim_trailing_whitespace = false

[*.{json,toml,yaml,yml}]
indent_size = 2
indent_style = space
tab_width = 2

[*.py]
indent_size = 4
indent_style = space
max_line_length = 80
tab_width = 4
