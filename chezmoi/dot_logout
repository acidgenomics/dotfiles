#!/usr/bin/env zsh

# """
# Scripts to run when logging out of current session.
# Updated 2026-10-16.
# """

# In POSIX sh, SHLVL is undefined.
# shellcheck disable=SC2039
if [ "${SHLVL:-0}" -eq 1 ]
then
    # When leaving the console, clear the screen to increase privacy.
    if [ -x '/usr/bin/clear_console' ]
    then
        '/usr/bin/clear_console' -q
    elif command -v clear >/dev/null 2>&1
    then
        # macOS has no 'clear_console'; clear the terminal screen instead.
        clear 2>/dev/null
    fi
    # Delete HISTFILE.
    # > if [ -f "${HISTFILE:-}" ]
    # > then
    # >     rm "$HISTFILE"
    # > fi
fi
