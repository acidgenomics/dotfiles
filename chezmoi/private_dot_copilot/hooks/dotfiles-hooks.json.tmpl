{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{ .chezmoi.homeDir }}/.agents/hooks/guard-installs.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"{{ .chezmoi.homeDir }}/.agents/hooks/guard-broad-scan.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
