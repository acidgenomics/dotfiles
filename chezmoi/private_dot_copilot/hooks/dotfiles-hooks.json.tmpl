{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{ .chezmoi.homeDir }}/.agents/hooks/guard-installs.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"{{ .chezmoi.homeDir }}/.agents/hooks/guard-broad-scan.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"{{ .chezmoi.homeDir }}/.agents/hooks/guard_rm.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"{{ .chezmoi.homeDir }}/.agents/hooks/guard_zsh_traps.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "env AGENT_HOOK_HARNESS=copilot python3 \"{{ .chezmoi.homeDir }}/.agents/hooks/guard_hook_writes.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{ .chezmoi.homeDir }}/.agents/hooks/guard_tmp.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
