# """
# GPG agent configuration.
# Updated 2022-12-06.
#
# Reload config:
# > gpgconf --kill gpg-agent
# > gpg-connect-agent reloadagent /bye
#
# These settings will prompt every time.
# > default-cache-ttl 0
# > max-cache-ttl 0
#
# Potentially useful:
# > allow-loopback-pinentry
# > enable-ssh-support
# """

# Extend re-use window to 8 hours.
# 60 * 60 * 8 = 28800
# > default-cache-ttl 600
default-cache-ttl 28800

# Force re-auth every day.
# 60 * 60 * 24 = 86400
# > max-cache-ttl 7200
max-cache-ttl 86400

# Configure pinentry.
{{- if eq .chezmoi.os "darwin" }}
{{- if lookPath "pinentry-mac" }}
pinentry-program {{ lookPath "pinentry-mac" }}
{{- end }}
{{- else if eq .chezmoi.os "linux" }}
# Alternatively, can use 'pinentry-tty'.
pinentry-program '/usr/bin/pinentry-curses'
{{- end }}
# Allow input for 1 minute.
pinentry-timeout 60
