def _add_config_link(source: str, name: str) -> None:
    config_dir = os.path.join(xdg_config_home(), "koopa")
    mkdir(config_dir)
    dest = os.path.join(config_dir, name)
    # Self-heal: no-op only if the link already resolves to the source.
    # A broken or mis-targeted symlink (or a stale file/dir) is repaired below.
    if os.path.islink(dest) and os.path.realpath(dest) == os.path.realpath(source):
        return
    ln(source, dest)


def _install_vscode_extension(
    vsix: str,
    prefix: str,
    ext_dir: str,
    code: str,
    label: str,
) -> None:
    """Install a VSIX extension if not already at the current version."""
    with zipfile.ZipFile(vsix) as zf:
        pkg = json.loads(zf.read("extension/package.json"))
    source_version = pkg["version"]
    installed_version = None
    if os.path.isdir(ext_dir):
        for d in os.listdir(ext_dir):
            if d.startswith(prefix):
                ver = d[len(prefix):]
                try:
                    ver_tuple = tuple(int(x) for x in ver.split("."))
                except ValueError:
                    continue
                if installed_version is None or ver_tuple > tuple(
                    int(x) for x in installed_version.split(".")
                ):
                    installed_version = ver
    if installed_version != source_version:
        if installed_version is not None:
            print(f"Upgrading {label}: {installed_version} → {source_version}")
        subprocess.run(
            [code, "--install-extension", vsix],
            capture_output=True,
            check=True,
        )
    if os.path.isdir(ext_dir):
        for d in os.listdir(ext_dir):
            if d.startswith(prefix) and d != prefix + source_version:
                stale = os.path.join(ext_dir, d)
                try:
                    rm(stale)
                except OSError as exc:
                    print(
                        f"Warning: could not remove stale extension "
                        f"directory: {stale} ({exc})"
                    )


def _positron_cli(home: str) -> str | None:
    """Return path to Positron CLI binary, or None if not installed."""
    candidates = [
        os.path.join(
            home, "Applications", "Positron.app",
            "Contents", "Resources", "app", "bin", "code",
        ),
        "/Applications/Positron.app/Contents/Resources/app/bin/code",
    ]
    for path in candidates:
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def _positron_ext_dir(home: str) -> str:
    """Return Positron's extension directory path."""
    return os.path.join(home, ".positron", "extensions")


def _cursor_ext_dir(home: str) -> str:
    """Return Cursor's extension directory path."""
    return os.path.join(home, ".cursor", "extensions")


def _antigravity_ext_dir(home: str) -> str:
    """Return Antigravity's extension directory path."""
    return os.path.join(home, ".antigravity", "extensions")


def _generate_pycharm_alucard_theme(
    dp_dir: str,
) -> tuple[str, str] | None:
    """Generate a Dracula Pro Alucard .theme.json and editor scheme .xml for JetBrains."""
    p = _parse_ghostty_palette(dp_dir, "alucard")
    if not p:
        return None
    vsix_path = os.path.join(
        xdg_config_home(), "koopa", "jetbrains-theme", "dracula-pro.zip"
    )
    if not os.path.isfile(vsix_path):
        return None
    with zipfile.ZipFile(vsix_path) as zf:
        jar_data = zf.read("dracula-pro/lib/dracula-pro-1.4.0.jar")
    with zipfile.ZipFile(io.BytesIO(jar_data)) as jar:
        dark_xml = jar.read("themes/DraculaPro.xml").decode()

    # Alucard palette
    bg        = "#fafafa"
    bg2       = "#EBEBEB"
    bg3       = "#DDDDE8"
    fg        = p["foreground"]
    selection = "#e8e8e8"
    selection2 = "#DDDDE8"
    purple    = p["blue"]
    purple2   = p["blue_bright"]
    pink      = p["magenta"]
    green     = p["green"]
    yellow    = p["yellow"]
    red       = p["red"]
    cyan      = p["cyan"]
    comment   = _hex_lerp(p["foreground"], "#fafafa", 0.6)

    # Build Alucard .theme.json by adapting the dark theme structure
    theme = {
        "name": "Dracula Pro Alucard",
        "dark": False,
        "author": "Zeno Rocha (light adaptation by koopa)",
        "editorScheme": "/themes/DraculaProAlucard.xml",
        "ui": {
            "*": {
                "arc": "5",
                "background": bg,
                "selectionBackground": selection,
                "selectionInactiveBackground": selection2,
                "inactiveBackground": bg,
                "borderColor": bg3,
                "underlineColor": purple,
            },
            "Borders": {"color": bg3, "ContrastBorderColor": bg3},
            "ActionButton": {
                "hoverBackground": bg2,
                "hoverBorderColor": bg2,
                "pressedBackground": bg2,
                "pressedBorderColor": bg2,
            },
            "Button": {
                "foreground": fg,
                "startBorderColor": purple,
                "endBorderColor": purple,
                "startBackground": purple,
                "endBackground": purple,
                "focusedBorderColor": purple,
                "default": {
                    "foreground": "#fafafa",
                    "startBackground": purple,
                    "endBackground": purple,
                    "startBorderColor": purple,
                    "endBorderColor": purple,
                    "focusColor": purple,
                    "focusedBorderColor": purple,
                },
            },
            "Counter": {"foreground": bg, "background": green},
            "CheckBoxMenuItem": {"acceleratorSelectionForeground": pink},
            "ComboBox": {
                "modifiedItemForeground": pink,
                "ArrowButton": {
                    "background": bg2,
                    "nonEditableBackground": bg2,
                    "iconColor": purple,
                },
                "selectionBackground": selection,
                "nonEditableBackground": bg2,
            },
            "CompletionPopup": {
                "selectionBackground": selection,
                "selectionInactiveBackground": selection2,
                "matchForeground": pink,
            },
            "Component": {
                "focusColor": purple2,
                "borderColor": purple,
                "focusedBorderColor": purple,
                "errorFocusColor": red,
                "inactiveErrorFocusColor": red,
                "warningFocusColor": yellow,
                "inactiveWarningFocusColor": yellow,
            },
            "DragAndDrop": {"areaBorderColor": purple},
            "Editor": {"background": bg, "shortcutForeground": pink},
            "EditorTabs": {
                "background": bg2,
                "underlinedTabBackground": bg,
                "underlineColor": pink,
                "underlineHeight": 2,
            },
            "FileColor": {
                "Blue": "#D6E4F7",
                "Green": "#D6EDD6",
                "Orange": "#F7E8D6",
                "Yellow": "#F7F5D6",
                "Rose": "#F0D6F0",
                "Violet": "#E8E8F5",
            },
            "Label": {"foreground": fg, "errorForeground": red},
            "Link": {
                "activeForeground": pink,
                "hoverForeground": pink,
                "visitedForeground": purple2,
                "pressedForeground": purple2,
            },
            "Notification": {
                "borderColor": purple,
                "errorBorderColor": red,
                "errorBackground": bg,
                "errorForeground": fg,
                "ToolWindow": {
                    "warningForeground": fg,
                    "warningBackground": bg,
                    "warningBorderColor": yellow,
                    "errorForeground": fg,
                    "errorBorderColor": red,
                    "errorBackground": bg,
                    "informativeForeground": fg,
                    "informativeBackground": bg,
                    "informativeBorderColor": green,
                },
            },
            "Plugins": {
                "SearchField": {"background": bg2},
                "SectionHeader": {"foreground": fg},
                "lightSelectionBackground": bg2,
                "Button": {
                    "installBorderColor": purple,
                    "installForeground": purple,
                    "installBackground": bg,
                    "installFillForeground": bg,
                    "installFillBackground": purple,
                    "installFocusedBackground": bg,
                    "updateBorderColor": cyan,
                    "updateForeground": fg,
                    "updateBackground": cyan,
                },
                "Tab": {
                    "selectedBackground": bg2,
                    "selectedForeground": fg,
                    "hoverBackground": bg2,
                },
            },
            "ProgressBar": {
                "failedColor": red,
                "failedEndColor": red,
                "trackColor": selection,
                "progressColor": pink,
                "indeterminateStartColor": purple2,
                "indeterminateEndColor": purple2,
                "passedColor": green,
                "passedEndColor": green,
            },
            "Popup": {
                "Header": {
                    "activeBackground": bg2,
                    "inactiveBackground": bg2,
                }
            },
            "SearchEverywhere": {
                "SearchField": {"background": bg2},
                "Tab": {
                    "selectedBackground": selection,
                    "selectedForeground": fg,
                },
            },
            "SearchMatch": {"startBackground": pink, "endBackground": pink},
            "Separator.separatorColor": bg2,
            "TabbedPane": {
                "tabSelectionHeight": 2,
                "focusColor": bg2,
                "hoverColor": bg2,
                "underlineColor": purple2,
                "contentAreaColor": bg2,
            },
            "ToggleButton": {
                "onBackground": green,
                "onForeground": bg,
                "offBackground": selection,
                "offForeground": bg,
                "buttonColor": fg,
            },
            "ToolWindow": {
                "Button": {"hoverBackground": bg2},
                "Header": {"background": bg2, "inactiveBackground": bg2},
                "HeaderTab": {
                    "underlineColor": purple2,
                    "underlineHeight": 2,
                    "underlinedTabBackground": selection,
                    "underlinedTabInactiveBackground": selection,
                },
            },
            "Tree": {
                "modifiedItemForeground": pink,
                "selectionBackground": selection,
                "selectionInactiveBackground": selection2,
            },
            "ValidationTooltip": {
                "errorBackground": red,
                "errorBorderColor": red,
                "warningBorderColor": yellow,
                "warningBackground": yellow,
            },
            "VersionControl": {
                "FileHistory": {
                    "Commit": {"selectedBranchBackground": bg2}
                },
                "GitLog": {
                    "headIconColor": yellow,
                    "localBranchIconColor": green,
                    "remoteBranchIconColor": purple2,
                    "tagIconColor": pink,
                    "otherIconColor": cyan,
                },
                "Log": {"Commit": {"currentBranchBackground": bg2}},
            },
            "WelcomeScreen": {
                "separatorColor": bg3,
                "Projects": {
                    "background": bg2,
                    "selectionBackground": selection,
                    "selectionInactiveBackground": selection2,
                },
            },
        },
        "icons": {
            "ColorPalette": {
                "Actions.Blue": cyan,
                "Actions.Green": green,
                "Actions.Grey": comment,
                "Actions.GreyInline.Dark": comment,
                "Actions.GreyInline": comment,
                "Actions.Red": red,
                "Actions.Yellow": yellow,
                "Objects.Blue": cyan,
                "Objects.Green": green,
                "Objects.GreenAndroid": green,
                "Objects.Grey": comment,
                "Objects.Pink": pink,
                "Objects.Purple": purple2,
                "Objects.Red": red,
                "Objects.RedStatus": red,
                "Objects.Yellow": yellow,
                "Objects.YellowDark": yellow,
                "Objects.BlackText": fg,
                "Checkbox.Border.Default.Dark": purple,
                "Checkbox.Border.Selected.Dark": purple,
                "Checkbox.Background.Default.Dark": bg,
                "Checkbox.Foreground.Selected.Dark": fg,
                "Checkbox.Focus.Wide.Dark": purple,
                "Checkbox.Focus.Thin.Selected.Dark": purple,
                "Checkbox.Focus.Thin.Default.Dark": purple,
            }
        },
    }

    # Build a dark→light substitution map entirely from runtime palette sources.
    # Keys come from the Pro (dark) Ghostty palette; values from the Alucard (light)
    # palette. No proprietary hex literals are typed here.
    pro = _parse_ghostty_palette(dp_dir, "pro")
    if not pro:
        return None
    fleet = _parse_fleet_palette(dp_dir, "alucard")
    ansi_roles = (
        "black", "red", "green", "yellow", "blue", "magenta", "cyan",
        "foreground", "black_bright", "red_bright", "green_bright",
        "yellow_bright", "blue_bright", "magenta_bright", "cyan_bright",
        "selection_bg", "cursor", "white_bright",
    )
    named_map: dict[str, str] = {}
    for role in ansi_roles:
        dark_val = pro.get(role, "")
        light_val = p.get(role, "")
        if dark_val and light_val:
            named_map[dark_val.lstrip("#").lower()] = light_val.lstrip("#").lower()
    if fleet:
        # Orange has no ANSI slot; read both dark key and light value from palettes.
        orange_dark = pro.get("yellow", "").lstrip("#").lower()
        # Use the Fleet Orange as the authoritative Alucard orange value.
        orange_light = fleet.get("Orange", "")
        if orange_dark and orange_light:
            named_map[orange_dark] = orange_light

    # Role-aware substitution. Background/decoration roles get the existing
    # pale-flip (_lightify_hex); foreground/text roles get
    # _darken_for_light_bg instead, or dark syntax colors (comments, strings,
    # doc-tags, ...) collapse into unreadable near-white text on the light
    # background -- a flat value-only substitution can't tell the two apart.
    # named_map's ANSI substitutions are tried first but only kept for a
    # foreground role if they clear 3:1: e.g. Pro's dark "selection_bg" hex is
    # reused by the vendor XML for LINE_NUMBERS_COLOR/INDENT_GUIDE/separators
    # too, and Alucard's selection_bg is deliberately close to the editor
    # background, so that substitution alone would leave those unreadable.
    _bg_role_re = re.compile(r"BACKGROUND|CARET_ROW_COLOR|STRIPE_COLOR")
    _option_hex_re = re.compile(r'<option name="([A-Za-z_0-9.]+)"\s+value="([0-9A-Fa-f]{6})"')

    def _sub_token(m: re.Match) -> str:  # type: ignore[type-arg]
        name, tok = m.group(1), m.group(2).lower()
        if _bg_role_re.search(name):
            replacement = _lightify_hex("#" + tok).lstrip("#").lower()
        elif tok in named_map and _contrast_ratio("#" + named_map[tok], bg) >= 3.0:
            replacement = named_map[tok]
        else:
            replacement = _darken_for_light_bg("#" + tok).lstrip("#").lower()
        return m.group(0).replace(m.group(2), replacement)

    xml = dark_xml
    xml = xml.replace('name="Dracula Pro"', 'name="Dracula Pro Alucard"')
    xml = xml.replace('parent_scheme="Darcula"', 'parent_scheme="Default"')
    xml = _option_hex_re.sub(_sub_token, xml)

    # Verify no dark Pro token survived and all backgrounds are light.
    survivors = (
        {t.lower() for t in re.findall(r'value="([0-9A-Fa-f]{6})"', xml)}
        & set(named_map)
    )
    assert not survivors, f"Dark Pro tokens survived XML substitution: {sorted(survivors)}"
    for m in re.finditer(r'name="[A-Z_]*BACKGROUND[^"]*"\s+value="([0-9A-Fa-f]{6})"', xml):
        assert _relative_luminance("#" + m.group(1)) >= 0.55, (
            f"Background not light enough after substitution: #{m.group(1)}"
        )
    # Verify every foreground/text role is actually readable, not just every
    # background role -- this is the check the pre-existing code lacked.
    for m in _option_hex_re.finditer(xml):
        if _bg_role_re.search(m.group(1)):
            continue
        ratio = _contrast_ratio("#" + m.group(2), bg)
        assert ratio >= 3.0, (
            f"{m.group(1)} contrast {ratio:.2f}:1 < 3:1 after substitution (#{m.group(2)})"
        )

    return json.dumps(theme, indent=2), xml


def _configure_jetbrains(home: str) -> None:
    """Configure JetBrains IDEs with Dracula Pro theme and sync with OS."""
    import glob as _glob
    if not is_macos():
        return
    dp_dir = os.path.join(xdg_data_home(), "dracula-pro")
    has_dracula_pro = os.path.isdir(dp_dir)
    jetbrains_base = os.path.join(home, "Library", "Application Support", "JetBrains")
    if not os.path.isdir(jetbrains_base):
        return
    # Find all JetBrains IDE settings directories
    ide_dirs = sorted(
        _glob.glob(os.path.join(jetbrains_base, "PyCharm[0-9]*"))
        + _glob.glob(os.path.join(jetbrains_base, "IntelliJIdea*"))
        + _glob.glob(os.path.join(jetbrains_base, "DataGrip*"))
        + _glob.glob(os.path.join(jetbrains_base, "WebStorm*"))
        + _glob.glob(os.path.join(jetbrains_base, "GoLand*"))
        + _glob.glob(os.path.join(jetbrains_base, "RustRover*"))
    )
    if not ide_dirs:
        return

    # Generate Alucard theme if Dracula Pro is available
    alucard_theme_json: str | None = None
    alucard_xml: str | None = None
    if has_dracula_pro:
        result = _generate_pycharm_alucard_theme(dp_dir)
        if result:
            alucard_theme_json, alucard_xml = result

    # themeIds: dark from the official plugin.xml; Alucard from koopa's local plugin
    _DP_DARK_THEME_ID = "171dce76-a3c5-4429-91af-41cf86094740"
    _DP_ALUCARD_THEME_ID = "a71dce76-a3c5-4429-91af-41cf86094740"
    # Built-in fallback themeIds (no Pro source available)
    _DARCULA_THEME_ID = "Darcula"
    _LIGHT_THEME_ID = "ExperimentalLight"

    # Staged official plugin zip (symlinked by _configure_dracula_pro_post)
    vsix_path = os.path.join(xdg_config_home(), "koopa", "jetbrains-theme", "dracula-pro.zip")
    has_plugin_zip = has_dracula_pro and os.path.isfile(vsix_path)

    # Current OS appearance — set authoritatively in main() before this runs
    is_light = os.environ.get("KOOPA_COLOR_MODE", "dark") == "light"

    for ide_dir in ide_dirs:
        options_dir = os.path.join(ide_dir, "options")
        os.makedirs(options_dir, exist_ok=True)
        plugins_dir = os.path.join(ide_dir, "plugins")

        newly_installed = False

        # Remove stale config-dir copies written by old koopa versions. IntelliJ
        # gives config-dir colors/ priority over plugin-bundled schemes of the same
        # name, so these would silently shadow the correct plugin scheme.
        for stale in (
            os.path.join(ide_dir, "colors", "Dracula Pro Alucard.xml"),
            os.path.join(ide_dir, "themes", "Dracula Pro Alucard.theme.json"),
        ):
            if os.path.isfile(stale):
                os.remove(stale)

        if has_plugin_zip:
            # Install official dark plugin if absent
            dark_plugin_dir = os.path.join(plugins_dir, "dracula-pro")
            if not os.path.isdir(dark_plugin_dir):
                os.makedirs(plugins_dir, exist_ok=True)
                with zipfile.ZipFile(vsix_path) as zf:
                    zf.extractall(plugins_dir)
                newly_installed = True

        if alucard_theme_json and alucard_xml:
            # Build the koopa Alucard plugin jar (pure-resource, no .class files)
            alucard_plugin_dir = os.path.join(plugins_dir, "dracula-pro-alucard", "lib")
            os.makedirs(alucard_plugin_dir, exist_ok=True)
            alucard_jar_path = os.path.join(alucard_plugin_dir, "dracula-pro-alucard.jar")
            plugin_xml = (
                '<idea-plugin>\n'
                '  <idea-version since-build="191"/>\n'
                '  <id>com.koopa.dracula-pro-alucard</id>\n'
                '  <name>Dracula Pro Alucard</name>\n'
                '  <version>1.0.0</version>\n'
                '  <vendor>koopa</vendor>\n'
                '  <depends>com.intellij.modules.lang</depends>\n'
                '  <extensions defaultExtensionNs="com.intellij">\n'
                f'    <themeProvider id="{_DP_ALUCARD_THEME_ID}"'
                ' path="/themes/DraculaProAlucard.theme.json"/>\n'
                '  </extensions>\n'
                '</idea-plugin>\n'
            )
            with zipfile.ZipFile(alucard_jar_path, "w", zipfile.ZIP_DEFLATED) as jar:
                jar.writestr("META-INF/MANIFEST.MF", "Manifest-Version: 1.0\n")
                jar.writestr("META-INF/plugin.xml", plugin_xml)
                jar.writestr("themes/DraculaProAlucard.theme.json", alucard_theme_json)
                jar.writestr("themes/DraculaProAlucard.xml", alucard_xml)

        # Write laf.xml — always rewrite so koopa can correct stale IDE defaults.
        # laf.xml holds only LafManager theme wiring; koopa owns this file.
        laf_path = os.path.join(options_dir, "laf.xml")
        if has_plugin_zip and alucard_theme_json:
            dark_id = _DP_DARK_THEME_ID
            light_id = _DP_ALUCARD_THEME_ID
            dark_scheme = "Dracula Pro"
            light_scheme = "Dracula Pro Alucard"
        else:
            dark_id = _DARCULA_THEME_ID
            light_id = _LIGHT_THEME_ID
            dark_scheme = "Darcula"
            light_scheme = "Default"
        active_id = light_id if is_light else dark_id
        laf_content = (
            '<application>\n'
            '  <component name="LafManager" autodetect="true">\n'
            f'    <laf themeId="{active_id}" />\n'
            f'    <preferred-light-laf themeId="{light_id}" />\n'
            f'    <preferred-dark-laf themeId="{dark_id}" />\n'
            f'    <preferred-light-editor-scheme editorSchemeId="{light_scheme}" />\n'
            f'    <preferred-dark-editor-scheme editorSchemeId="{dark_scheme}" />\n'
            '  </component>\n'
            '</application>\n'
        )
        with open(laf_path, "w") as fh:
            fh.write(laf_content)

        # Merge ide.mac.appearance.mode=system into ide.general.xml
        general_xml_path = os.path.join(options_dir, "ide.general.xml")
        if os.path.isfile(general_xml_path):
            with open(general_xml_path) as fh:
                content = fh.read()
            if "ide.mac.appearance.mode" not in content:
                content = content.replace(
                    '  <component name="Registry">',
                    '  <component name="Registry">\n'
                    '    <entry key="ide.mac.appearance.mode" value="system" />',
                )
                with open(general_xml_path, "w") as fh:
                    fh.write(content)
        else:
            with open(general_xml_path, "w") as fh:
                fh.write(
                    '<application>\n'
                    '  <component name="Registry">\n'
                    '    <entry key="ide.mac.appearance.mode" value="system" />\n'
                    '  </component>\n'
                    '</application>\n'
                )

        if newly_installed:
            print(
                f"JetBrains ({os.path.basename(ide_dir)}): installed Dracula Pro plugins.\n"
                "  Quit PyCharm (if running) and restart it to apply the theme.\n"
                "  On first launch you may see a third-party plugin consent prompt — "
                "click Enable."
            )


def _configure_koopa_color_mode_sync(home: str) -> None:
    """Install the koopa-color-mode-sync VS Code extension."""
    ext_src_dir = os.path.join(str(_PREFIX), "etc", "vscode", "koopa-color-mode-sync")
    vsix = os.path.join(ext_src_dir, "koopa-color-mode-sync-0.1.0.vsix")
    if not os.path.isfile(vsix):
        return
    with zipfile.ZipFile(vsix) as zf:
        pkg = json.loads(zf.read("extension/package.json"))
    publisher = pkg["publisher"]
    ext_name = pkg["name"]
    dir_prefix = f"{publisher}.{ext_name}-"
    targets: list[tuple[str, str]] = []
    code = shutil.which("code")
    if code:
        targets.append((code, os.path.join(home, ".vscode", "extensions")))
    code_server = shutil.which("code-server")
    if code_server:
        targets.append((
            code_server,
            os.path.join(home, ".local", "share", "code-server", "extensions"),
        ))
    positron = _positron_cli(home)
    if positron:
        targets.append((positron, _positron_ext_dir(home)))
    cursor = shutil.which("cursor")
    if cursor:
        targets.append((cursor, _cursor_ext_dir(home)))
    antigravity = shutil.which("antigravity")
    if antigravity:
        targets.append((antigravity, _antigravity_ext_dir(home)))
    for binary, ext_dir in targets:
        _install_vscode_extension(
            vsix, dir_prefix, ext_dir, binary,
            "koopa-color-mode-sync extension",
        )


def _configure_dracula_pro(home: str, xdg_data: str) -> None:
    """Pre-chezmoi: vim pack, Ghostty theme links, VS Code extension install."""
    dp_dir = os.path.join(xdg_data, "dracula-pro")
    if not os.path.isdir(dp_dir):
        return
    # Vim/Neovim: symlink theme pack so nvim detects it at runtime.
    vim_src = os.path.join(dp_dir, "themes", "vim")
    vim_themes = os.path.join(home, ".vim", "pack", "theme", "start")
    mkdir(vim_themes)
    if os.path.isdir(vim_src):
        ln(vim_src, os.path.join(vim_themes, "dracula_pro"))
    # Ghostty: generate each variant theme file into ~/.config/ghostty/themes/,
    # rewriting ANSI slot 8 to a readable dim color (see
    # _generate_ghostty_dracula_pro_theme). Not a symlink: Ghostty, and any
    # terminal app that reads its ANSI palette (htop's shadow color pair),
    # would otherwise get the unreadable upstream value straight from disk.
    # Runs pre-chezmoi (not in _configure_dracula_pro_post) because
    # config.tmpl stats this directory at render time to pick theme names;
    # doing this post-chezmoi would leave the render one install cycle behind.
    ghostty_themes = os.path.join(home, ".config", "ghostty", "themes")
    ghostty_src = os.path.join(dp_dir, "themes", "ghostty")
    if os.path.isdir(ghostty_src):
        mkdir(ghostty_themes)
        for src_name, dest_name in _DRACULA_VARIANT_NAMES.items():
            theme = _generate_ghostty_dracula_pro_theme(dp_dir, src_name)
            if theme:
                dest = os.path.join(ghostty_themes, dest_name)
                # Earlier koopa versions symlinked dest to the upstream file.
                # Writing through a stale symlink would corrupt that upstream
                # copy, so clear it first -- rm() unlinks the symlink itself,
                # never the file it points to.
                if os.path.lexists(dest):
                    rm(dest)
                with open(dest, "w") as fh:
                    fh.write(theme)
    # VS Code / Positron: install VSIX if missing or version doesn't match.
    vsix = os.path.join(
        dp_dir, "themes", "visual-studio-code", "dracula-pro.vsix"
    )
    if os.path.isfile(vsix):
        dp_prefix = "dracula-theme-pro.theme-dracula-pro-"
        code = shutil.which("code")
        if code:
            _install_vscode_extension(
                vsix, dp_prefix,
                os.path.join(home, ".vscode", "extensions"),
                code, "Dracula Pro VS Code extension",
            )
        positron = _positron_cli(home)
        if positron:
            _install_vscode_extension(
                vsix, dp_prefix,
                _positron_ext_dir(home),
                positron, "Dracula Pro Positron extension",
            )
        cursor = shutil.which("cursor")
        if cursor:
            _install_vscode_extension(
                vsix, dp_prefix,
                _cursor_ext_dir(home),
                cursor, "Dracula Pro Cursor extension",
            )
        antigravity = shutil.which("antigravity")
        if antigravity:
            _install_vscode_extension(
                vsix, dp_prefix,
                _antigravity_ext_dir(home),
                antigravity, "Dracula Pro Antigravity extension",
            )
    # Colorblind-safe diff/status colors (delta, git native [color], VS Code
    # workbench.colorCustomizations): generated here, pre-chezmoi, not in
    # _configure_dracula_pro_post. Their chezmoi templates `stat` the
    # generated fragment at template-render time (unlike tmux.conf.tmpl,
    # which only checks the *source* dp_dir and defers the actual file check
    # to tmux's own runtime `source-file` -- see koopa-chezmoi-dotfiles skill,
    # "Templates Run Before Post-Install Generators"). Generating post-chezmoi
    # would make every fragment exist one run too late: chezmoi apply (inside
    # main(), below) runs before _configure_dracula_pro_post, so the first
    # apply would always render the fallback, converging only on a second run
    # of the whole installer. mkdir() instead of an isdir() guard, since on a
    # first-ever install chezmoi hasn't created these directories yet either.
    diff_colorblind_variant = os.environ.get("KOOPA_DRACULA_PRO_VARIANT", "pro")
    delta_dir = os.path.join(home, ".config", "delta")
    mkdir(delta_dir)
    dark_diff_colors = _generate_delta_diff_colors_gitconfig(dp_dir, diff_colorblind_variant)
    if dark_diff_colors:
        with open(
            os.path.join(delta_dir, "dracula-pro-diff-colors.gitconfig"), "w"
        ) as fh:
            fh.write(dark_diff_colors)
    alucard_diff_colors = _generate_delta_diff_colors_gitconfig(dp_dir, "alucard")
    if alucard_diff_colors:
        with open(
            os.path.join(delta_dir, "dracula-pro-alucard-diff-colors.gitconfig"), "w"
        ) as fh:
            fh.write(alucard_diff_colors)
    git_config_dir = os.path.join(home, ".config", "git")
    mkdir(git_config_dir)
    dark_native_colors = _generate_git_native_colorblind_gitconfig(dp_dir, diff_colorblind_variant)
    if dark_native_colors:
        with open(
            os.path.join(git_config_dir, "dracula-pro-colorblind.gitconfig"), "w"
        ) as fh:
            fh.write(dark_native_colors)
    alucard_native_colors = _generate_git_native_colorblind_gitconfig(dp_dir, "alucard")
    if alucard_native_colors:
        with open(
            os.path.join(git_config_dir, "dracula-pro-alucard-colorblind.gitconfig"), "w"
        ) as fh:
            fh.write(alucard_native_colors)
    vscode_diff_colors = _generate_vscode_diff_colorcustomizations(dp_dir, diff_colorblind_variant)
    if vscode_diff_colors:
        koopa_config_dir = os.path.join(xdg_config_home(), "koopa")
        mkdir(koopa_config_dir)
        with open(
            os.path.join(koopa_config_dir, "vscode-diff-colors.json"), "w"
        ) as fh:
            fh.write(vscode_diff_colors)


def _configure_dracula_pro_post(home: str, xdg_data: str) -> None:
    """Post-chezmoi: all apps that need chezmoi-created dirs to exist first."""
    dp_dir = os.path.join(xdg_data, "dracula-pro")
    if not os.path.isdir(dp_dir):
        return
    variant = os.environ.get("KOOPA_DRACULA_PRO_VARIANT", "pro")
    # Alacritty: symlink Pro/Alucard variants to chezmoi-UNMANAGED sidecar names.
    # alacritty.toml.tmpl selects these at render time when Pro is installed; the
    # chezmoi-managed themes/dracula.toml / themes/one-light.toml (OSS) are left
    # untouched so chezmoi converges (no dual ownership -> no perpetual MM loop).
    alacritty_themes = os.path.join(home, ".config", "alacritty", "themes")
    alacritty_src_dir = os.path.join(dp_dir, "themes", "alacritty", "themes")
    if os.path.isdir(alacritty_themes) and os.path.isdir(alacritty_src_dir):
        variant_file = (
            "dracula-pro.toml"
            if variant == "pro"
            else f"dracula-pro-{variant}.toml"
        )
        dark_src = os.path.join(alacritty_src_dir, variant_file)
        if os.path.isfile(dark_src):
            ln(dark_src, os.path.join(alacritty_themes, "dracula-pro.toml"))
        alucard_src = os.path.join(alacritty_src_dir, "dracula-pro-alucard.toml")
        if os.path.isfile(alucard_src):
            ln(alucard_src, os.path.join(alacritty_themes, "dracula-pro-alucard.toml"))
    # Emacs/Doom: symlink all variant .el files into ~/.config/doom/themes/.
    doom_themes = os.path.join(home, ".config", "doom", "themes")
    emacs_src = os.path.join(dp_dir, "themes", "emacs")
    if os.path.isdir(emacs_src):
        mkdir(doom_themes)
        for el_file in os.listdir(emacs_src):
            if el_file.endswith(".el"):
                ln(
                    os.path.join(emacs_src, el_file),
                    os.path.join(doom_themes, el_file),
                )
    # iTerm: symlink selected variant into ~/.config/koopa/iterm-themes/ so it
    # survives a dotfiles reinstall (the old etc/ staging dir lived inside the
    # wiped prefix and was gitignored, causing it to disappear on every reinstall).
    iterm_src_name = _dracula_iterm_name(variant)
    iterm_src = os.path.join(dp_dir, "themes", "iterm", iterm_src_name)
    if os.path.isfile(iterm_src):
        iterm_staging = os.path.join(xdg_config_home(), "koopa", "iterm-themes")
        mkdir(iterm_staging)
        ln(iterm_src, os.path.join(iterm_staging, "dracula-pro.itermcolors"))
    # Terminal.app: symlink selected variant into ~/.config/koopa/terminal-themes/
    # for the same reason (stable location outside the reinstallable prefix).
    terminal_src_name = _dracula_terminal_name(variant)
    terminal_src = os.path.join(
        dp_dir, "themes", "terminal-app", terminal_src_name
    )
    if os.path.isfile(terminal_src):
        terminal_staging = os.path.join(
            xdg_config_home(), "koopa", "terminal-themes"
        )
        mkdir(terminal_staging)
        ln(terminal_src, os.path.join(terminal_staging, "dracula-pro.terminal"))
    # Xcode: symlink all variant .xccolortheme files into Xcode's theme dir.
    if is_macos():
        xcode_themes = os.path.join(
            home, "Library", "Developer", "Xcode", "UserData", "FontAndColorThemes"
        )
        xcode_src = os.path.join(dp_dir, "themes", "xcode")
        if os.path.isdir(xcode_src):
            mkdir(xcode_themes)
            for f in os.listdir(xcode_src):
                if f.endswith(".xccolortheme"):
                    ln(
                        os.path.join(xcode_src, f),
                        os.path.join(xcode_themes, f),
                    )
    # Zed: symlink theme JSON into ~/.config/zed/themes/.
    zed_themes = os.path.join(home, ".config", "zed", "themes")
    zed_src = os.path.join(dp_dir, "themes", "zed", "dracula_pro.json")
    if os.path.isfile(zed_src):
        mkdir(zed_themes)
        ln(zed_src, os.path.join(zed_themes, "dracula_pro.json"))
    # Firefox: symlink all variant .xpi dirs into ~/.config/koopa/firefox-themes/.
    firefox_staging = os.path.join(xdg_config_home(), "koopa", "firefox-themes")
    firefox_src = os.path.join(dp_dir, "themes", "firefox")
    if os.path.isdir(firefox_src):
        mkdir(firefox_staging)
        for entry in os.listdir(firefox_src):
            src = os.path.join(firefox_src, entry)
            if os.path.isdir(src):
                ln(src, os.path.join(firefox_staging, entry))
    # Google Chrome: symlink variant dir into ~/.config/koopa/chrome-themes/.
    chrome_staging = os.path.join(xdg_config_home(), "koopa", "chrome-themes")
    chrome_src_dir = os.path.join(dp_dir, "themes", "google-chrome")
    if os.path.isdir(chrome_src_dir):
        mkdir(chrome_staging)
        for entry in os.listdir(chrome_src_dir):
            src = os.path.join(chrome_src_dir, entry)
            if os.path.isdir(src):
                ln(src, os.path.join(chrome_staging, entry))
    # Hyper: symlink variant .js file into ~/.config/koopa/hyper-themes/.
    hyper_staging = os.path.join(xdg_config_home(), "koopa", "hyper-themes")
    hyper_variants = os.path.join(dp_dir, "themes", "hyper", "variants")
    if os.path.isdir(hyper_variants):
        mkdir(hyper_staging)
        for f in os.listdir(hyper_variants):
            if f.endswith(".js"):
                ln(
                    os.path.join(hyper_variants, f),
                    os.path.join(hyper_staging, f),
                )
    # JetBrains: symlink plugin zip into ~/.config/koopa/jetbrains-theme/.
    jetbrains_staging = os.path.join(
        xdg_config_home(), "koopa", "jetbrains-theme"
    )
    jetbrains_src = os.path.join(
        dp_dir, "themes", "jetbrains", "dracula-pro.zip"
    )
    if os.path.isfile(jetbrains_src):
        mkdir(jetbrains_staging)
        ln(
            jetbrains_src,
            os.path.join(jetbrains_staging, "dracula-pro.zip"),
        )
    # Windows Terminal: symlink all variant JSON files into staging dir.
    wt_staging = os.path.join(
        xdg_config_home(), "koopa", "windows-terminal-themes"
    )
    wt_src = os.path.join(dp_dir, "themes", "windows-terminal")
    if os.path.isdir(wt_src):
        mkdir(wt_staging)
        for f in os.listdir(wt_src):
            if f.endswith(".json"):
                ln(
                    os.path.join(wt_src, f),
                    os.path.join(wt_staging, f),
                )
    # Insomnia: symlink plugin dir if Insomnia is installed.
    insomnia_plugins = os.path.join(
        home, "Library", "Application Support", "Insomnia", "plugins"
    )
    insomnia_src = os.path.join(dp_dir, "themes", "insomnia", "dracula-pro")
    if os.path.isdir(insomnia_src) and os.path.isdir(insomnia_plugins):
        ln(insomnia_src, os.path.join(insomnia_plugins, "dracula-pro"))
    # Sublime Text: symlink themes dir as a Packages entry.
    sublime_packages = os.path.join(
        home, "Library", "Application Support", "Sublime Text", "Packages"
    )
    sublime_src = os.path.join(dp_dir, "themes", "sublime")
    if os.path.isdir(sublime_src) and os.path.isdir(sublime_packages):
        ln(sublime_src, os.path.join(sublime_packages, "Dracula Pro"))
    # JetBrains Fleet: symlink JSON themes dir if Fleet is installed.
    fleet_themes = os.path.join(home, ".fleet", "themes")
    fleet_src = os.path.join(dp_dir, "themes", "jetbrains", "experimental")
    if os.path.isdir(fleet_src) and os.path.isdir(os.path.join(home, ".fleet")):
        mkdir(fleet_themes)
        for f in os.listdir(fleet_src):
            if f.endswith(".json"):
                ln(
                    os.path.join(fleet_src, f),
                    os.path.join(fleet_themes, f),
                )
    # gnome-terminal: run variant install.sh non-interactively (Linux only).
    if not is_macos():
        gnome_install_sh = os.path.join(
            dp_dir, "themes", "gnome-terminal", variant, "install.sh"
        )
        if os.path.isfile(gnome_install_sh):
            subprocess.run(
                ["bash", gnome_install_sh],
                capture_output=True,
            )
    # Notepad++: stage XML files for manual install.
    notepad_staging = os.path.join(xdg_config_home(), "koopa", "notepad-themes")
    notepad_src = os.path.join(dp_dir, "themes", "notepad-plus-plus")
    if os.path.isdir(notepad_src):
        mkdir(notepad_staging)
        for f in os.listdir(notepad_src):
            if f.endswith(".xml"):
                ln(
                    os.path.join(notepad_src, f),
                    os.path.join(notepad_staging, f),
                )
    # Raycast: stage JSON files for manual import.
    raycast_staging = os.path.join(xdg_config_home(), "koopa", "raycast-themes")
    raycast_src = os.path.join(dp_dir, "themes", "raycast", "json-files")
    if os.path.isdir(raycast_src):
        mkdir(raycast_staging)
        for f in os.listdir(raycast_src):
            if f.endswith(".json"):
                ln(
                    os.path.join(raycast_src, f),
                    os.path.join(raycast_staging, f),
                )
    # Tmux: generate Pro/Alucard palettes to chezmoi-UNMANAGED sidecar names.
    # tmux.conf.tmpl selects these at render time when Pro is installed; the
    # chezmoi-managed dark.conf/light.conf (OSS) are left untouched so chezmoi
    # converges (no dual ownership -> no perpetual MM loop).
    tmux_colors = os.path.join(home, ".config", "tmux", "colors")
    if os.path.isdir(tmux_colors):
        pro_conf = _generate_tmux_dracula_pro_conf(dp_dir, variant)
        if pro_conf:
            with open(os.path.join(tmux_colors, "dracula-pro.conf"), "w") as fh:
                fh.write(pro_conf)
        alucard_conf = _generate_tmux_alucard_conf(dp_dir)
        if alucard_conf:
            with open(
                os.path.join(tmux_colors, "dracula-pro-alucard.conf"), "w"
            ) as fh:
                fh.write(alucard_conf)
    # Claude Code: generate custom theme files selected at runtime by
    # settings.json.tmpl ("theme": "custom:dracula-pro[-alucard]", branched on
    # KOOPA_COLOR_MODE). ~/.claude/themes/ is not chezmoi-managed, so this
    # never shows up as chezmoi drift.
    claude_prefix = os.path.join(home, ".claude")
    if os.path.isdir(claude_prefix):
        claude_themes = os.path.join(claude_prefix, "themes")
        mkdir(claude_themes)
        claude_dark = _generate_claude_dracula_pro_theme(dp_dir, variant)
        if claude_dark:
            with open(os.path.join(claude_themes, "dracula-pro.json"), "w") as fh:
                fh.write(claude_dark)
        claude_alucard = _generate_claude_dracula_pro_theme(dp_dir, "alucard")
        if claude_alucard:
            with open(
                os.path.join(claude_themes, "dracula-pro-alucard.json"), "w"
            ) as fh:
                fh.write(claude_alucard)
    # Obsidian: generate one theme.css with real .theme-dark (variant) and
    # .theme-light (always alucard) blocks -- Obsidian's own Settings >
    # Appearance toggle switches modes natively, so unlike every other app
    # above this needs no KOOPA_COLOR_MODE branching. Vaults are per-vault,
    # not a fixed config dir, so this is symlinked into every vault found in
    # Obsidian's own registry, not a single hardcoded path. Never touch
    # .obsidian/appearance.json -- Obsidian owns and rewrites that file on
    # every settings change; picking "Dracula Pro" stays a one-time manual
    # step in the app, same as any other community theme.
    obsidian_css = _generate_obsidian_dracula_pro_theme(dp_dir, variant)
    if obsidian_css:
        obsidian_staging = os.path.join(
            xdg_config_home(), "koopa", "obsidian-themes", "dracula-pro"
        )
        mkdir(obsidian_staging)
        css_path = os.path.join(obsidian_staging, "theme.css")
        manifest_path = os.path.join(obsidian_staging, "manifest.json")
        with open(css_path, "w") as fh:
            fh.write(obsidian_css)
        with open(manifest_path, "w") as fh:
            fh.write(_generate_obsidian_manifest())
        for obsidian_dir in _obsidian_vault_dirs(home):
            theme_dir = os.path.join(obsidian_dir, "themes", "Dracula Pro")
            mkdir(theme_dir)
            ln(css_path, os.path.join(theme_dir, "theme.css"))
            ln(manifest_path, os.path.join(theme_dir, "manifest.json"))
    # Zsh: generate palette files sourced at runtime by .zshrc.
    zsh_config = os.path.join(home, ".config", "zsh")
    if os.path.isdir(zsh_config):
        zsh_palette = _generate_zsh_dracula_pro_palette(dp_dir, variant)
        if zsh_palette:
            with open(os.path.join(zsh_config, "dracula-pro-colors.zsh"), "w") as fh:
                fh.write(zsh_palette)
        alucard_palette = _generate_zsh_dracula_pro_palette(dp_dir, "alucard")
        if alucard_palette:
            with open(
                os.path.join(zsh_config, "dracula-pro-alucard-colors.zsh"), "w"
            ) as fh:
                fh.write(alucard_palette)
    # Fish: generate fzf palette files sourced at runtime by conf.d/koopa.fish.
    fish_config = os.path.join(home, ".config", "fish")
    if os.path.isdir(fish_config):
        fish_palette = _generate_fish_dracula_pro_palette(dp_dir, variant)
        if fish_palette:
            with open(
                os.path.join(fish_config, "dracula-pro-colors.fish"), "w"
            ) as fh:
                fh.write(fish_palette)
        fish_alucard_palette = _generate_fish_dracula_pro_palette(dp_dir, "alucard")
        if fish_alucard_palette:
            with open(
                os.path.join(fish_config, "dracula-pro-alucard-colors.fish"), "w"
            ) as fh:
                fh.write(fish_alucard_palette)
    # Kitty: generate Dracula Pro theme conf files for selected variant and Alucard.
    kitty_themes = os.path.join(home, ".config", "kitty", "themes")
    if os.path.isdir(kitty_themes):
        dark_kitty_conf = _generate_kitty_dracula_pro_conf(dp_dir, variant)
        if dark_kitty_conf:
            with open(os.path.join(kitty_themes, "dracula-pro.conf"), "w") as fh:
                fh.write(dark_kitty_conf)
        alucard_kitty_conf = _generate_kitty_dracula_pro_conf(dp_dir, "alucard")
        if alucard_kitty_conf:
            with open(os.path.join(kitty_themes, "dracula-pro-alucard.conf"), "w") as fh:
                fh.write(alucard_kitty_conf)
    # WezTerm: generate Dracula Pro TOML color scheme files in ~/.config/wezterm/colors/.
    wezterm_config = os.path.join(home, ".config", "wezterm")
    if os.path.isdir(wezterm_config):
        wezterm_colors = os.path.join(wezterm_config, "colors")
        mkdir(wezterm_colors)
        dark_wez = _generate_wezterm_dracula_pro_toml(dp_dir, variant)
        if dark_wez:
            with open(os.path.join(wezterm_colors, "Dracula Pro.toml"), "w") as fh:
                fh.write(dark_wez)
        alucard_wez = _generate_wezterm_dracula_pro_toml(dp_dir, "alucard")
        if alucard_wez:
            with open(os.path.join(wezterm_colors, "Dracula Pro Alucard.toml"), "w") as fh:
                fh.write(alucard_wez)
    # Atuin: generate Dracula Pro theme TOML files in ~/.config/atuin/themes/.
    atuin_themes = os.path.join(home, ".config", "atuin", "themes")
    if os.path.isdir(os.path.join(home, ".config", "atuin")):
        os.makedirs(atuin_themes, exist_ok=True)
        dark_atuin = _generate_atuin_dracula_pro_toml(dp_dir, variant)
        if dark_atuin:
            with open(os.path.join(atuin_themes, "dracula-pro.toml"), "w") as fh:
                fh.write(dark_atuin)
        alucard_atuin = _generate_atuin_dracula_pro_toml(dp_dir, "alucard")
        if alucard_atuin:
            with open(os.path.join(atuin_themes, "dracula-pro-alucard.toml"), "w") as fh:
                fh.write(alucard_atuin)
    # Btop: generate Dracula Pro theme files in ~/.config/btop/themes/.
    btop_themes = os.path.join(home, ".config", "btop", "themes")
    if os.path.isdir(os.path.join(home, ".config", "btop")):
        os.makedirs(btop_themes, exist_ok=True)
        dark_btop = _generate_btop_dracula_pro_theme(dp_dir, variant)
        if dark_btop:
            with open(os.path.join(btop_themes, "dracula-pro.theme"), "w") as fh:
                fh.write(dark_btop)
        alucard_btop = _generate_btop_dracula_pro_theme(dp_dir, "alucard")
        if alucard_btop:
            with open(os.path.join(btop_themes, "dracula-pro-alucard.theme"), "w") as fh:
                fh.write(alucard_btop)
    # Bat: symlink Pro .tmTheme files into ~/.config/bat/themes/ and rebuild cache.
    _tmtheme_name_map = {
        "pro": "Dracula Pro.tmTheme",
        "blade": "Dracula Pro (Blade).tmTheme",
        "buffy": "Dracula Pro (Buffy).tmTheme",
        "lincoln": "Dracula Pro (Lincoln).tmTheme",
        "morbius": "Dracula Pro (Morbius).tmTheme",
        "van-helsing": "Dracula Pro (Van Helsing).tmTheme",
        "alucard": "Dracula Pro (Alucard).tmTheme",
    }
    bat_themes = os.path.join(home, ".config", "bat", "themes")
    sublime_src = os.path.join(dp_dir, "themes", "sublime")
    if os.path.isdir(sublime_src):
        os.makedirs(bat_themes, exist_ok=True)
        dark_fname = _tmtheme_name_map.get(variant, "Dracula Pro.tmTheme")
        dark_tmtheme = os.path.join(sublime_src, dark_fname)
        if os.path.isfile(dark_tmtheme):
            ln(dark_tmtheme, os.path.join(bat_themes, "Dracula Pro.tmTheme"))
        alucard_tmtheme = os.path.join(sublime_src, "Dracula Pro (Alucard).tmTheme")
        if os.path.isfile(alucard_tmtheme):
            ln(alucard_tmtheme, os.path.join(bat_themes, "Dracula Pro (Alucard).tmTheme"))
        bat_bin = shutil.which("bat")
        if bat_bin:
            subprocess.run([bat_bin, "cache", "--build"], capture_output=True)
    # RStudio: generate .rstheme from .tmTheme source (no Pro colors in repo).
    rstudio_themes = os.path.join(home, ".config", "rstudio", "themes")
    template_rstheme = os.path.join(
        str(_PREFIX), "chezmoi", "dot_config", "rstudio", "themes", "dracula.rstheme"
    )
    if os.path.isdir(rstudio_themes) and os.path.isfile(template_rstheme):
        # Generate the selected dark variant.
        dark_css = _generate_rstudio_rstheme(dp_dir, variant, template_rstheme)
        if dark_css:
            with open(os.path.join(rstudio_themes, "dracula-pro.rstheme"), "w") as fh:
                fh.write(dark_css)
        # Always generate Alucard (light) variant as well.
        alucard_css = _generate_rstudio_rstheme(dp_dir, "alucard", template_rstheme)
        if alucard_css:
            with open(
                os.path.join(rstudio_themes, "dracula-pro-alucard.rstheme"), "w"
            ) as fh:
                fh.write(alucard_css)
    # BBEdit 16 is sandboxed — TCC blocks writes to ~/Library/Application Support/BBEdit/.
    # Generate .bbColorScheme files into the source dir; user opens them in BBEdit to install.
    # If BBEdit iCloud sync is enabled, also write directly into that Color Schemes folder.
    if is_macos():
        bbedit_out = os.path.join(dp_dir, "themes", "bbedit")
        os.makedirs(bbedit_out, exist_ok=True)
        dark_scheme = _generate_bbedit_dracula_pro(dp_dir, variant)
        alucard_scheme = _generate_bbedit_dracula_pro(dp_dir, "alucard")
        bbedit_icloud = os.path.join(
            home,
            "Library",
            "Mobile Documents",
            "iCloud~com~barebones~bbedit",
            "Documents",
            "Application Support",
            "Color Schemes",
        )
        newly_created = False
        for scheme, name in (
            (dark_scheme, "Dracula Pro.bbColorScheme"),
            (alucard_scheme, "Dracula Pro Alucard.bbColorScheme"),
        ):
            if not scheme:
                continue
            dest = os.path.join(bbedit_out, name)
            if not os.path.isfile(dest):
                newly_created = True
            with open(dest, "w") as fh:
                fh.write(scheme)
            if os.path.isdir(bbedit_icloud):
                with open(os.path.join(bbedit_icloud, name), "w") as fh:
                    fh.write(scheme)
        if newly_created:
            if os.path.isdir(bbedit_icloud):
                print("BBEdit: color schemes installed via iCloud sync.")
            else:
                print(
                    f"BBEdit: open .bbColorScheme files from {bbedit_out} in BBEdit to install."
                )


def _parse_ghostty_palette(dp_dir: str, variant: str) -> dict[str, str] | None:
    """Parse hex colors from a Ghostty theme file. Returns dict of role->hex."""
    theme_file = os.path.join(dp_dir, "themes", "ghostty", variant)
    if not os.path.isfile(theme_file):
        return None
    ansi: dict[int, str] = {}
    extras: dict[str, str] = {}
    with open(theme_file) as fh:
        for line in fh:
            line = line.strip()
            if line.startswith("palette = "):
                _, rest = line.split("=", 1)
                idx_str, color = rest.strip().split("=", 1)
                ansi[int(idx_str.strip())] = color.strip()
            elif "=" in line and not line.startswith("#"):
                key, val = line.split("=", 1)
                extras[key.strip()] = val.strip()
    if not ansi:
        return None
    fg = extras.get("foreground", ansi.get(7, "#F8F8F2"))
    bg = extras.get("background", ansi.get(0, "#282a36"))
    return {
        "foreground":   fg,
        "selection_bg": extras.get("selection-background", ansi.get(8, "#44475a")),
        "red":          ansi.get(1, "#ff5555"),
        "green":        ansi.get(2, "#50fa7b"),
        "yellow":       ansi.get(3, "#f1fa8c"),
        "blue":         ansi.get(4, "#bd93f9"),
        "magenta":      ansi.get(5, "#ff79c6"),
        "cyan":         ansi.get(6, "#8be9fd"),
        "black":        ansi.get(0, "#282a36"),
        # Raw ANSI slot 8. Only safe as a *background* (e.g. an inactive tab
        # panel) -- too low-contrast to use as text. Use "comment" for text.
        "black_bright": ansi.get(8, "#6272a4"),
        "red_bright":   ansi.get(9, "#ff6e6e"),
        "green_bright": ansi.get(10, "#69ff94"),
        "yellow_bright": ansi.get(11, "#ffffa5"),
        "blue_bright":  ansi.get(12, "#d6acff"),
        "magenta_bright": ansi.get(13, "#ff92df"),
        "cyan_bright":  ansi.get(14, "#a4ffff"),
        # Readable dim/comment text color -- see _dracula_dim_color().
        "comment":      _dracula_dim_color(dp_dir, variant, fg, bg),
        "cursor":       extras.get("cursor-color", "#6272a4"),
        "white_bright": ansi.get(15, "#ffffff"),
    }


_VIM_PALETTE_RE = re.compile(
    r"^let g:dracula_pro#palette\.([a-z_]+)\s*=\s*\['(#[0-9A-Fa-f]{6})'"
)


def _parse_vim_palette(dp_dir: str, variant: str) -> dict[str, str] | None:
    """Parse the named-role palette from a Dracula Pro vim colorscheme.

    Unlike the ghostty palette (16 raw ANSI slots), this source names
    orange/pink/purple explicitly and provides a 5-step background ramp
    (bg/bgdark/bgdarker/bglight/bglighter), which the per-token Claude Code
    theme mapping needs and the ANSI-only ghostty palette lacks.
    """
    if variant == "pro":
        path = os.path.join(dp_dir, "themes", "vim", "autoload", "dracula_pro.vim")
    else:
        # Variant keys are hyphenated (e.g. "van-helsing"); the shipped Vim
        # colorscheme filenames use an underscore.
        slug = variant.replace("-", "_")
        path = os.path.join(
            dp_dir, "themes", "vim", "colors", f"dracula_pro_{slug}.vim"
        )
    if not os.path.isfile(path):
        return None
    palette: dict[str, str] = {}
    with open(path) as fh:
        for line in fh:
            match = _VIM_PALETTE_RE.match(line)
            if match:
                palette[match.group(1)] = match.group(2)
    return palette or None


def _dracula_dim_color(
    dp_dir: str, variant: str, fallback_fg: str, fallback_bg: str
) -> str:
    """Return a dim-but-readable color for ANSI slot 8.

    Every Dracula Pro variant sets slot 8 within ~2.4:1 contrast of its own
    background (1.09:1 for Alucard), so anything that treats ANSI 8 as a
    dim/comment/shadow color -- including htop's meter-shadow color pair --
    renders as unreadable. The named ``comment`` role from the variant's Vim
    colorscheme clears at least 3.5:1 against the background in every
    variant, so prefer it. Fall back to a foreground/background blend
    (mirroring the ``comment`` derivation in ``_generate_pycharm_alucard_theme``)
    if the Vim palette is unavailable.
    """
    vim_palette = _parse_vim_palette(dp_dir, variant)
    if vim_palette and "comment" in vim_palette:
        return vim_palette["comment"]
    return _hex_lerp(fallback_fg, fallback_bg, 0.6)


# Real theme labels contributed by the installed VS Code extension's
# package.json (contributes.themes[].label) -- NOT reproducible from the
# variant key via title-casing. "van-helsing" -> "Van Helsing" (a space, not
# the hyphen str.title()/sprig's title would keep), verified against the
# actual installed .vsix rather than assumed.
_VSCODE_DRACULA_THEME_LABELS = {
    "pro": "Dracula Pro",
    "blade": "Dracula Pro (Blade)",
    "buffy": "Dracula Pro (Buffy)",
    "lincoln": "Dracula Pro (Lincoln)",
    "morbius": "Dracula Pro (Morbius)",
    "van-helsing": "Dracula Pro (Van Helsing)",
    "alucard": "Dracula Pro (Alucard)",
}


def _generate_diff_colorblind_palette(dp_dir: str, variant: str) -> dict[str, str] | None:
    """Derive a colorblind-friendly diff/file-state palette (blue/orange/cyan).

    Red/green is the classic hardest pair for red-green color-vision
    deficiency (deuteranopia/protanopia) to distinguish. The Dracula Pro VS
    Code extension, the vim colorscheme, and koopa's own generators before
    this one all use plain green=added/red=removed -- there is no vendor
    precedent for this substitution, it's a deliberate override, not an
    adoption of upstream convention. What *is* adopted from upstream: orange
    for a "modified/changed" role (verified against the vendor's own
    gitDecoration.modifiedResourceForeground and the vim colorscheme's
    DiffChange/DiffText groups -- both use orange, independently of this
    file), and alpha levels for VS Code's translucent backgrounds (see
    _generate_vscode_diff_colorcustomizations).

    added=blue, removed=orange for diff-line concepts (delta, git diff,
    VS Code diffEditor.*). added=blue, modified=orange (vendor-exact, never
    overridden), deleted=cyan for file-state concepts (git status,
    gitDecoration.*) -- deleted can't also be orange once modified owns it,
    and the two roles co-occur in the same `git status` output.

    Blue and orange sit on opposite sides of the color wheel and stay
    distinguishable under every common color-vision simulation, but deriving
    the diff-line backgrounds naively (each blended toward `bg` to hit the
    *same* target contrast) makes the luminance-closeness problem worse, not
    better: both land at nearly the same luminance, converging to a 1.01:1
    mutual contrast almost regardless of hue. Deliberately using two
    *different* target ratios (1.3 and 2.2) forces them apart in lightness
    too, verified below. The file-state roles (raw_blue/raw_orange/raw_cyan,
    used as plain text rather than a background wash) skip that treatment:
    each git-status entry is always paired with its own English label
    ("modified:", "deleted:"), so hue-only separation is enough there too --
    the same standard the vendor's own theme uses for this same distinction.

    Returns terminal-appropriate (pre-composited, opaque) colors for the
    diff-line backgrounds -- a real terminal has no alpha compositing, so the
    tint has to be baked in. VS Code's generator derives its own diff-line
    values from raw_blue/raw_orange with an alpha suffix instead, since VS
    Code composites live.
    """
    g = _parse_ghostty_palette(dp_dir, variant)
    v = _parse_vim_palette(dp_dir, variant)
    if not g or not v:
        return None
    bg, fg = v["bg"], v["fg"]
    raw_blue, raw_cyan = g["blue"], g["cyan"]
    raw_orange = _nudge_hue_toward(v["orange"], v["yellow"], 33.0)

    def _tint(role_hex: str, target_ratio: float) -> str:
        lo, hi = 0.0, 1.0
        for _ in range(30):
            mid = (lo + hi) / 2
            if _contrast_ratio(_hex_lerp(role_hex, bg, mid), bg) >= target_ratio:
                lo = mid
            else:
                hi = mid
        return _hex_lerp(role_hex, bg, lo)

    added_bg = _tint(raw_blue, 1.3)
    removed_bg = _tint(raw_orange, 2.2)
    assert _contrast_ratio(added_bg, removed_bg) >= 1.5, (
        f"[diff-colorblind:{variant}] added/removed tints too similar: "
        f"{_contrast_ratio(added_bg, removed_bg):.2f}:1"
    )
    assert _contrast_ratio(fg, added_bg) >= 4.5, (
        f"[diff-colorblind:{variant}] text unreadable on added tint"
    )
    assert _contrast_ratio(fg, removed_bg) >= 4.5, (
        f"[diff-colorblind:{variant}] text unreadable on removed tint"
    )
    assert _contrast_ratio(raw_blue, bg) >= 3.0, (
        f"[diff-colorblind:{variant}] raw blue unreadable as text on bg"
    )
    assert _contrast_ratio(raw_orange, bg) >= 3.0, (
        f"[diff-colorblind:{variant}] raw orange unreadable as text on bg"
    )
    assert _contrast_ratio(raw_cyan, bg) >= 3.0, (
        f"[diff-colorblind:{variant}] raw cyan unreadable as text on bg"
    )
    return {
        "bg": bg,
        "fg": fg,
        "raw_blue": raw_blue,
        "raw_orange": raw_orange,
        "raw_cyan": raw_cyan,
        "added_bg": added_bg,
        "removed_bg": removed_bg,
        "vscode_theme_label": _VSCODE_DRACULA_THEME_LABELS.get(variant, "Dracula Pro"),
    }


def _generate_ghostty_dracula_pro_theme(dp_dir: str, variant: str) -> str | None:
    """Return the upstream Ghostty theme text with ANSI slot 8 replaced.

    Ghostty itself resolves ANSI 8 straight from this file, and so does any
    terminal app that asks the terminal for it directly (htop's meter-shadow
    color pair does exactly that). There is no koopa-owned config downstream
    to intercept that read, so -- unlike every other Dracula Pro consumer in
    this file, which is generated fresh -- the Ghostty theme itself must
    become a generated file instead of a symlink to the upstream one.
    """
    p = _parse_ghostty_palette(dp_dir, variant)
    if not p:
        return None
    theme_file = os.path.join(dp_dir, "themes", "ghostty", variant)
    with open(theme_file) as fh:
        text = fh.read()
    return re.sub(r"(?m)^palette = 8=.*$", f"palette = 8={p['comment']}", text, count=1)


def _generate_tmux_dracula_pro_conf(dp_dir: str, variant: str) -> str | None:
    """Generate a tmux dark.conf with Dracula Pro colors for the given variant."""
    p = _parse_ghostty_palette(dp_dir, variant)
    if not p:
        return None
    return f"""\
# Dracula Pro color palette ({variant}).
# Auto-generated by koopa dotfiles install from local Dracula Pro source.

# Standard ANSI colors.
%hidden black='{p["black"]}'
%hidden black_bright='{p["black_bright"]}'
%hidden red='{p["red"]}'
%hidden red_bright='{p["red_bright"]}'
%hidden green='{p["green"]}'
%hidden green_bright='{p["green_bright"]}'
%hidden yellow='{p["yellow"]}'
%hidden yellow_bright='{p["yellow_bright"]}'
%hidden blue='{p["blue"]}'
%hidden blue_bright='{p["blue_bright"]}'
%hidden magenta='{p["magenta"]}'
%hidden magenta_bright='{p["magenta_bright"]}'
%hidden cyan='{p["cyan"]}'
%hidden cyan_bright='{p["cyan_bright"]}'
%hidden white='{p["foreground"]}'
%hidden white_bright='#ffffff'

# Additional accent colors.
%hidden bright_purple='{p["blue"]}'
%hidden dark_purple='{p["black"]}'
%hidden muted_purple='{p["comment"]}'

set-option -g message-style "bg=${{dark_purple}},fg=${{white}}"
set-option -g pane-active-border-style "fg=${{bright_purple}}"
set-option -g pane-border-style "fg=${{dark_purple}}"
set-option -g status-left "#[bg=#{{bright_purple}},fg=${{black}}]#{{?client_prefix,#[bg=${{green}}],}} #S "
set-option -g status-right "#[fg=${{white}}] #h %I:%M %p "
set-option -g status-style "bg=${{dark_purple}},fg=${{white}}"
set-window-option -g window-status-current-format "#[fg=${{white}},bg=${{muted_purple}}] #I #W "
set-window-option -g window-status-format "#[fg=${{white}}] #I #W "
"""


def _generate_tmux_alucard_conf(dp_dir: str) -> str | None:
    """Generate a tmux light.conf with Dracula Pro Alucard colors."""
    p = _parse_ghostty_palette(dp_dir, "alucard")
    if not p:
        return None
    fg = p["foreground"]       # #383a42
    bg = "#fafafa"
    selection = "#e8e8e8"
    border_active = p["blue"]  # #a626a4
    border_inactive = "#e8e8e8"
    comment = p["comment"]     # #a0a1a7
    green = p["green"]         # #50a14f
    blue = p["blue"]           # #a626a4
    return f"""\
# Dracula Pro Alucard color palette.
# Auto-generated by koopa dotfiles install from local Dracula Pro source.

%hidden bg='{bg}'
%hidden fg='{fg}'
%hidden selection='{selection}'
%hidden comment='{comment}'
%hidden green='{green}'
%hidden blue='{blue}'
%hidden border_active='{border_active}'
%hidden border_inactive='{border_inactive}'

set-option -g message-style "bg={bg},fg={fg}"
set-option -g pane-active-border-style "fg={border_active}"
set-option -g pane-border-style "fg={border_inactive}"
set-option -g status-left "#[bg={green},fg={bg}]#{{?client_prefix,#[bg={blue}],}} #S "
set-option -g status-right "#[fg={fg}] #h %I:%M %p "
set-option -g status-style "bg={bg},fg={fg}"
set-window-option -g window-status-current-format "#[fg={fg},bg={selection}] #I #W "
set-window-option -g window-status-format "#[fg={comment}] #I #W "
"""


def _generate_delta_diff_colors_gitconfig(dp_dir: str, variant: str) -> str | None:
    """Generate delta plus-style/minus-style overrides for colorblind-safe diffs.

    Emitted as its own gitconfig fragment (not baked into
    _generate_tmux_dracula_pro_conf-style full files) because theme.gitconfig.tmpl
    already branches dark/light on KOOPA_COLOR_MODE -- unlike settings.json.tmpl,
    which must never branch on it (see koopa-vscode skill). Delta re-reads its
    config fresh on every invocation, so there's no live-app write race to avoid.
    """
    palette = _generate_diff_colorblind_palette(dp_dir, variant)
    if not palette:
        return None
    return f"""\
[delta "theme_{'dark' if variant != 'alucard' else 'light'}"]
    plus-style = syntax "{palette['added_bg']}"
    minus-style = syntax "{palette['removed_bg']}"
"""


def _generate_git_native_colorblind_gitconfig(dp_dir: str, variant: str) -> str | None:
    """Generate colorblind-safe overrides for git's own [color] sections.

    Only the roles that actually need to change: `color.branch.remote` (was
    bare ANSI "yellow", which resolves to a muddy olive/brown in Alucard --
    see _dracula_dim_color's docstring for the same defect in ANSI slot 8;
    "yellow" has an analogous problem), `color.diff.meta` (same "yellow"
    defect; reuses the already-verified dim/comment color instead, a better
    semantic fit for de-emphasized metadata lines anyway), `color.diff.new`/
    `old` and `color.status.added`/`changed`/`deleted` (the colorblind
    substitution -- see _generate_diff_colorblind_palette's docstring for why
    status.deleted is cyan, not orange, even though diff.old is orange).
    `color.branch.current`/`local`, `color.diff.frag`/`newMoved`, and
    `color.status.untracked` are untouched: no defect, or (untracked) matches
    the vendor's own accepted default.
    """
    p = _generate_diff_colorblind_palette(dp_dir, variant)
    if not p:
        return None
    meta = _dracula_dim_color(dp_dir, variant, p["fg"], p["bg"])
    return f"""\
[color "branch"]
    remote = "{p['raw_cyan']}"
[color "diff"]
    meta = "{meta}"
    new = "{p['raw_blue']}"
    old = "{p['raw_orange']}"
[color "status"]
    added = "{p['raw_blue']}"
    changed = "{p['raw_orange']}"
    deleted = "{p['raw_cyan']}"
"""


# Color IDs verified against a real installed VS Code (workbench.desktop.main.js
# for the diffEditor*/editorGutter*/scmGraph* core IDs; the bundled Git
# extension's own package.json contributes.colors for gitDecoration.* -- those
# are NOT in the core bundle, a plain grep against workbench.desktop.main.js
# alone would have reported them as fake). See koopa-chezmoi-dotfiles skill
# for the verification order this follows.
#
# Alpha suffixes (20/40/80) match the Dracula Pro extension's own theme JSON
# exactly (themes/dracula-pro*.json colors.diffEditor.*) -- not invented, read
# directly from the installed .vsix: line backgrounds 20 (~12%), text
# backgrounds 40 (~25%), gutter 80 (~50%).
#
# diffEditor.*/diffEditorGutter.*/editorGutter.*/scmGraph.* are the DIFF-LINE
# concept (added/removed within a diff) -- blue/orange, matching delta and
# git's native color.diff. gitDecoration.* is the FILE-STATE concept (a whole
# file added/modified/deleted) -- blue/cyan, NOT blue/orange, because orange
# is reserved for "modified" (gitDecoration.modifiedResourceForeground is left
# untouched at the vendor's own default, which already IS orange -- see
# _generate_diff_colorblind_palette's docstring) and modified/deleted co-occur
# in the same Source Control view, so they can't share a hue.
_VSCODE_DIFF_LINE_KEYS_ADDED = (
    # (color id, alpha suffix or None for opaque)
    ("diffEditor.insertedLineBackground", "20"),
    ("diffEditor.insertedTextBackground", "40"),
    ("diffEditorGutter.insertedLineBackground", "80"),
    ("editorGutter.addedBackground", "80"),
    ("scmGraph.historyItemHoverAdditionsForeground", None),
)
_VSCODE_DIFF_LINE_KEYS_REMOVED = (
    ("diffEditor.removedLineBackground", "20"),
    ("diffEditor.removedTextBackground", "40"),
    ("diffEditorGutter.removedLineBackground", "80"),
    ("editorGutter.deletedBackground", "80"),
    ("scmGraph.historyItemHoverDeletionsForeground", None),
)
_VSCODE_FILE_STATE_KEYS = (
    ("gitDecoration.addedResourceForeground", "raw_blue"),
    ("gitDecoration.deletedResourceForeground", "raw_cyan"),
)


def _generate_vscode_diff_colorcustomizations(dp_dir: str, variant: str) -> str | None:
    """Generate a workbench.colorCustomizations fragment for colorblind-safe diffs.

    VS Code composites color-customization values live over the underlying
    syntax-highlighted text, so the *Background keys need alpha, not a
    pre-composited opaque hex -- unlike the terminal (delta), which has no
    compositing and needs the opposite (see
    _generate_diff_colorblind_palette). Text-role keys (gitDecoration.*,
    scmGraph.*) stay opaque since nothing is drawn on top of them.

    Theme-scoped (``"[Dracula Pro]"``/``"[Dracula Pro (Alucard)]"``) rather
    than KOOPA_COLOR_MODE-branched: settings.json.tmpl must never branch on
    KOOPA_COLOR_MODE (write race with VS Code's own writes and the
    color-mode-sync watcher -- see the koopa-vscode skill), and VS Code
    already applies whichever scope matches the active theme on its own via
    window.autoDetectColorScheme.

    Returns only the two ``"[Theme]": { ... }`` blocks, comma-joined, with no
    outer ``"workbench.colorCustomizations": { ... }`` wrapper and no leading
    or trailing comma -- Code/Antigravity/Cursor already have an unscoped
    "workbench.colorCustomizations" key (vscode-fork-common.tmpl); a second
    one in the same object would silently lose whichever comes first when
    parsed (JSON keeps the last duplicate key). The chezmoi partial
    (dracula-pro-diff-colors.tmpl) splices this into whichever
    "workbench.colorCustomizations" object each app's settings.json.tmpl
    already has (or opens, for Positron, which has none).
    """
    dark = _generate_diff_colorblind_palette(dp_dir, variant)
    light = _generate_diff_colorblind_palette(dp_dir, "alucard")
    if not dark or not light:
        return None

    def _block(p: dict[str, str]) -> str:
        lines = []
        for key, alpha in _VSCODE_DIFF_LINE_KEYS_ADDED:
            lines.append(f'      "{key}": "{p["raw_blue"]}{alpha or ""}",')
        for key, alpha in _VSCODE_DIFF_LINE_KEYS_REMOVED:
            lines.append(f'      "{key}": "{p["raw_orange"]}{alpha or ""}",')
        for key, role in _VSCODE_FILE_STATE_KEYS:
            lines.append(f'      "{key}": "{p[role]}",')
        lines[-1] = lines[-1].rstrip(",")
        return "\n".join(lines)

    return f"""\
    "[{dark['vscode_theme_label']}]": {{
{_block(dark)}
    }},
    "[{light['vscode_theme_label']}]": {{
{_block(light)}
    }}
"""


def _generate_kitty_dracula_pro_conf(dp_dir: str, variant: str) -> str | None:
    """Generate a kitty theme .conf with Dracula Pro colors for the given variant."""
    p = _parse_ghostty_palette(dp_dir, variant)
    if not p:
        return None
    is_light = variant == "alucard"
    bg = p["black"] if not is_light else "#fafafa"
    fg = p["foreground"]
    return f"""\
# vim:ft=kitty

## name: Dracula Pro ({variant.capitalize()})
## blurb: Auto-generated by koopa dotfiles install from local Dracula Pro source.

foreground                      {fg}
background                      {bg}
selection_foreground            {fg}
selection_background            {p["blue"]}

cursor                          {fg}
cursor_text_color               {bg}

active_border_color     {p["blue"]}
inactive_border_color   {p["comment"]}

active_tab_foreground   {bg}
active_tab_background   {fg}
inactive_tab_foreground {p["comment"]}
inactive_tab_background {p["black_bright"]}

color0  {p["black"]}
color8  {p["comment"]}
color1  {p["red"]}
color9  {p["red_bright"]}
color2  {p["green"]}
color10 {p["green_bright"]}
color3  {p["yellow"]}
color11 {p["yellow_bright"]}
color4  {p["blue"]}
color12 {p["blue_bright"]}
color5  {p["magenta"]}
color13 {p["magenta_bright"]}
color6  {p["cyan"]}
color14 {p["cyan_bright"]}
color7  {fg}
color15 {"#FFFFFF" if is_light else "#FFFFFF"}
"""


def _generate_wezterm_dracula_pro_toml(dp_dir: str, variant: str) -> str | None:
    """Generate a WezTerm TOML color scheme for a Dracula Pro variant."""
    p = _parse_ghostty_palette(dp_dir, variant)
    if not p:
        return None
    is_light = variant == "alucard"
    bg = "#fafafa" if is_light else p["black"]
    fg = p["foreground"]
    if variant == "alucard":
        name = "Dracula Pro Alucard"
    elif variant == "pro":
        name = "Dracula Pro"
    else:
        name = f"Dracula Pro ({variant.capitalize()})"
    return f"""\
[metadata]
name = "{name}"

[colors]
foreground = "{fg}"
background = "{bg}"
cursor_fg = "{bg}"
cursor_bg = "{fg}"
selection_fg = "{fg}"
selection_bg = "{p['selection_bg']}"

ansi = [
  "{p['black']}", "{p['red']}", "{p['green']}", "{p['yellow']}",
  "{p['blue']}", "{p['magenta']}", "{p['cyan']}", "{fg}",
]
brights = [
  "{p['comment']}", "{p['red_bright']}", "{p['green_bright']}", "{p['yellow_bright']}",
  "{p['blue_bright']}", "{p['magenta_bright']}", "{p['cyan_bright']}", "#FFFFFF",
]

[colors.tab_bar]
background = "{bg}"

[colors.tab_bar.active_tab]
bg_color = "{p['blue']}"
fg_color = "{fg}"

[colors.tab_bar.inactive_tab]
bg_color = "{p['black_bright']}"
fg_color = "{p['comment']}"

[colors.tab_bar.new_tab]
bg_color = "{bg}"
fg_color = "{p['comment']}"
"""


def _generate_atuin_dracula_pro_toml(dp_dir: str, variant: str) -> str | None:
    """Generate an atuin theme TOML for a Dracula Pro variant."""
    p = _parse_ghostty_palette(dp_dir, variant)
    if not p:
        return None
    fg = p["foreground"]
    # Alucard's ANSI 8 (comment) is #FFFFFF — invisible on light bg.
    # Use selection-background color (#a0a1a7 equivalent) as muted instead.
    comment = "#a0a1a7" if variant == "alucard" else p["comment"]
    theme_name = f"dracula-pro-{variant}" if variant != "pro" else "dracula-pro"
    return f"""\
# Atuin Dracula Pro theme ({variant}).
# Auto-generated by koopa dotfiles install from local Dracula Pro source.

[theme]
name = "{theme_name}"

[colors]
Important = "{fg}"
Title = "{fg}"
Annotation = "{comment}"
Guidance = "{p['cyan']}"
AlertInfo = "{p['green']}"
AlertWarn = "{p['yellow']}"
AlertError = "{p['red']}"
Muted = "{comment}"
"""


def _generate_btop_dracula_pro_theme(dp_dir: str, variant: str) -> str | None:
    """Generate a btop ".theme" file for a Dracula Pro variant.

    Sourced from ``_parse_vim_palette()`` rather than the ghostty ANSI palette:
    btop's ``main_bg``/``meter_bg``/``selected_bg``/``div_line`` need the named
    background ramp (bg/bgdark/bglight/...) and named orange/pink/purple accents
    that only the vim palette provides. Gradient stops are built with
    ``_hex_lerp()`` between two named roles -- never invented intermediate hex --
    mirroring how the free ``dracula.theme`` shades each 3-stop ramp toward the
    background or foreground.
    """
    p = _parse_vim_palette(dp_dir, variant)
    if not p:
        return None
    theme_name = f"Dracula Pro ({variant.title()})" if variant != "pro" else "Dracula Pro"
    return f"""\
#{theme_name} theme
# Auto-generated by koopa dotfiles install from local Dracula Pro source.

theme[main_bg]="{p['bg']}"
theme[main_fg]="{p['fg']}"
theme[title]="{p['fg']}"
theme[hi_fg]="{p['purple']}"
theme[selected_bg]="{p['selection']}"
theme[selected_fg]="{p['fg']}"
theme[inactive_fg]="{p['comment']}"
theme[graph_text]="{p['fg']}"
theme[meter_bg]="{p['bgdark']}"
theme[proc_misc]="{p['purple']}"
theme[cpu_box]="{p['purple']}"
theme[mem_box]="{p['green']}"
theme[net_box]="{p['red']}"
theme[proc_box]="{p['cyan']}"
theme[div_line]="{p['comment']}"

theme[temp_start]="{p['purple']}"
theme[temp_mid]="{p['pink']}"
theme[temp_end]="{p['red']}"

theme[cpu_start]="{p['purple']}"
theme[cpu_mid]="{p['cyan']}"
theme[cpu_end]="{p['green']}"

theme[free_start]="{_hex_lerp(p['pink'], p['bg'], 0.5)}"
theme[free_mid]="{p['pink']}"
theme[free_end]="{_hex_lerp(p['pink'], p['fg'], 0.3)}"

theme[cached_start]="{_hex_lerp(p['cyan'], p['bg'], 0.5)}"
theme[cached_mid]="{p['cyan']}"
theme[cached_end]="{_hex_lerp(p['cyan'], p['fg'], 0.3)}"

theme[available_start]="{_hex_lerp(p['orange'], p['bg'], 0.5)}"
theme[available_mid]="{p['orange']}"
theme[available_end]="{_hex_lerp(p['orange'], p['fg'], 0.3)}"

theme[used_start]="{_hex_lerp(p['green'], p['bg'], 0.5)}"
theme[used_mid]="{p['green']}"
theme[used_end]="{_hex_lerp(p['green'], p['fg'], 0.3)}"

theme[download_start]="{p['purple']}"
theme[download_mid]="{p['green']}"
theme[download_end]="{p['cyan']}"

theme[upload_start]="{_hex_lerp(p['pink'], p['fg'], 0.3)}"
theme[upload_mid]="{p['pink']}"
theme[upload_end]="{_hex_lerp(p['pink'], p['red'], 0.5)}"

theme[process_start]="{p['green']}"
theme[process_mid]="{_hex_lerp(p['green'], p['comment'], 0.5)}"
theme[process_end]="{p['comment']}"
"""


