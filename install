def _fzf_color_opts(p: dict[str, str], variant: str) -> str:
    """Build the fzf --color option string from a parsed palette.

    Shared by the zsh and fish palette generators so the color math
    (notably the alucard light-bg override) lives in exactly one place.
    """
    fg = p["foreground"]
    bg = "#fafafa" if variant == "alucard" else p["black"]
    hl = p["blue"]
    sel_bg = p["selection_bg"]
    return (
        f"--color=fg:{fg},bg:{bg},hl:{hl} "
        f"--color=fg+:{fg},bg+:{sel_bg},hl+:{hl} "
        f"--color=info:{p['yellow']},prompt:{p['green']},pointer:{p['magenta']} "
        f"--color=marker:{p['magenta']},spinner:{p['yellow']},header:{p['comment']}"
    )


def _generate_fish_dracula_pro_palette(dp_dir: str, variant: str) -> str | None:
    """Generate ~/.config/fish/dracula-pro-colors.fish from local Dracula Pro source.

    Emits a full set of fish_color_* variables (sourced by conf.d/koopa.fish at
    startup and on dark<->light flips) followed by FZF_DEFAULT_OPTS.
    """
    p = _parse_ghostty_palette(dp_dir, variant)
    if not p:
        return None
    # In alucard, ANSI 8 is white, invisible on the light bg; use the cursor
    # color (runtime-derived) as the dim/comment tone for that variant.
    dim = p["cursor"] if variant == "alucard" else p["comment"]
    lines = [
        f"# Dracula Pro fish palette ({variant}).",
        "# Auto-generated by koopa dotfiles install from local Dracula Pro source.",
    ]
    for var, role in _FISH_COLOR_ROLES:
        if role == "autosuggest":
            # Match zsh's ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=103' (xterm-256
            # index 103 = #8787af). Not a Pro hex; allowlist-safe generic neutral.
            lines.append(f"set -g {var} #8787af")
        elif role == "dim":
            lines.append(f"set -g {var} {dim}")
        elif role == "selection_bg":
            lines.append(f"set -g {var} --background={p['selection_bg']}")
        elif role == "underline":
            lines.append(f"set -g {var} --underline")
        elif role == "cyan_bold":
            lines.append(f"set -g {var} --bold {p['cyan']}")
        else:
            lines.append(f"set -g {var} {p[role]}")
    lines.append(f"set -gx FZF_DEFAULT_OPTS '{_fzf_color_opts(p, variant)}'")
    return "\n".join(lines) + "\n"


def _generate_zsh_dracula_pro_palette(dp_dir: str, variant: str) -> str | None:
    """Generate ~/.config/zsh/dracula-pro-colors.zsh from local Dracula Pro source."""
    p = _parse_ghostty_palette(dp_dir, variant)
    if not p:
        return None
    autosuggest_ansi = {
        "pro": "fg=103",
        "blade": "fg=109",
        "buffy": "fg=139",
        "lincoln": "fg=144",
        "morbius": "fg=138",
        "van-helsing": "fg=109",
        "alucard": "fg=103",
    }.get(variant, "fg=103")
    lines = [
        f"# Dracula Pro zsh syntax-highlighting palette ({variant}).",
        "# Auto-generated by koopa dotfiles install from local Dracula Pro source.",
        f"export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='{autosuggest_ansi}'",
        "ZSH_HIGHLIGHT_HIGHLIGHTERS=('main' 'cursor')",
        "typeset -gA ZSH_HIGHLIGHT_STYLES",
    ]
    color_map = {
        "foreground":   p["foreground"],
        "red":          p["red"],
        "green":        p["green"],
        "yellow":       p["yellow"],
        "blue":         p["blue"],
        "magenta":      p["magenta"],
        "cyan":         p["cyan"],
        "comment":      p["comment"],
    }
    for role, color_key in _ZSH_HIGHLIGHT_ROLES:
        if color_key is None:
            lines.append(f"ZSH_HIGHLIGHT_STYLES['{role}']='standout'")
        elif color_key == "green_italic":
            lines.append(
                f"ZSH_HIGHLIGHT_STYLES['{role}']='fg={color_map['green']},italic'"
            )
        elif color_key == "yellow_italic":
            lines.append(
                f"ZSH_HIGHLIGHT_STYLES['{role}']='fg={color_map['yellow']},italic'"
            )
        else:
            hex_val = color_map.get(color_key, p.get(color_key, "#F8F8F2"))
            lines.append(f"ZSH_HIGHLIGHT_STYLES['{role}']='fg={hex_val}'")
    lines.append(f"export FZF_DEFAULT_OPTS='{_fzf_color_opts(p, variant)}'")
    return "\n".join(lines) + "\n"


# Claude Code custom-theme token -> Dracula Pro vim-palette role. A value may be
# a bare role name, or (role, "shimmer") for a lightened/darkened sibling tone.
# Tokens not listed here are intentionally left unset so they inherit from the
# theme's declared "base" (dark/light), which Claude Code already renders
# legibly. See koopa-theming skill: never hardcode Pro hex, only derive at
# runtime from the local Dracula Pro source.
_CLAUDE_THEME_TOKEN_ROLES: list[tuple[str, str | tuple[str, str]]] = [
    ("text", "fg"),
    ("inverseText", "bg"),
    ("inactive", "comment"),
    ("inactiveShimmer", ("comment", "shimmer")),
    ("subtle", "comment"),
    ("promptBorder", "comment"),
    ("promptBorderShimmer", ("comment", "shimmer")),
    ("autoAccept", "purple"),
    ("autoAcceptShimmer", ("purple", "shimmer")),
    ("skill", "purple"),
    ("merged", "purple"),
    ("effortUltra", "purple"),
    ("permission", "purple"),
    ("permissionShimmer", ("purple", "shimmer")),
    ("suggestion", "purple"),
    ("remember", "purple"),
    ("rate_limit_fill", "purple"),
    ("rate_limit_empty", "selection"),
    ("planMode", "cyan"),
    ("background", "cyan"),
    ("claudeBlue_FOR_SYSTEM_SPINNER", "cyan"),
    ("claudeBlueShimmer_FOR_SYSTEM_SPINNER", ("cyan", "shimmer")),
    ("ide", "cyan"),
    ("professionalBlue", "cyan"),
    ("briefLabelYou", "cyan"),
    ("bashBorder", "pink"),
    ("success", "green"),
    ("error", "red"),
    ("warning", "yellow"),
    ("warningShimmer", ("yellow", "shimmer")),
    ("chromeYellow", "yellow"),
    ("claude", "orange"),
    ("claudeShimmer", ("orange", "shimmer")),
    ("clawd_body", "orange"),
    ("briefLabelClaude", "orange"),
    ("fastMode", "orange"),
    ("fastModeShimmer", ("orange", "shimmer")),
    ("selectionBg", "selection"),
    ("userMessageBackground", "bgdark"),
    ("userMessageBackgroundHover", "bgdarker"),
    ("composerSidebarBackground", "bgdark"),
    ("bashMessageBackgroundColor", "bgdark"),
    ("memoryBackgroundColor", "bgdark"),
    ("clawd_background", "bgdarker"),
    ("red_FOR_SUBAGENTS_ONLY", "red"),
    ("blue_FOR_SUBAGENTS_ONLY", "cyan"),
    ("green_FOR_SUBAGENTS_ONLY", "green"),
    ("yellow_FOR_SUBAGENTS_ONLY", "yellow"),
    ("purple_FOR_SUBAGENTS_ONLY", "purple"),
    ("orange_FOR_SUBAGENTS_ONLY", "orange"),
    ("pink_FOR_SUBAGENTS_ONLY", "pink"),
    ("cyan_FOR_SUBAGENTS_ONLY", "cyan"),
    ("rainbow_red", "red"),
    ("rainbow_orange", "orange"),
    ("rainbow_yellow", "yellow"),
    ("rainbow_green", "green"),
    ("rainbow_blue", "cyan"),
    ("rainbow_indigo", "indigo"),
    ("rainbow_violet", "pink"),
    ("rainbow_red_shimmer", ("red", "shimmer")),
    ("rainbow_orange_shimmer", ("orange", "shimmer")),
    ("rainbow_yellow_shimmer", ("yellow", "shimmer")),
    ("rainbow_green_shimmer", ("green", "shimmer")),
    ("rainbow_blue_shimmer", ("cyan", "shimmer")),
    ("rainbow_indigo_shimmer", ("indigo", "shimmer")),
    ("rainbow_violet_shimmer", ("pink", "shimmer")),
]

# diffAdded/diffRemoved are muted background washes (blended heavily toward
# bg); *Word is the bright unblended accent used for intra-line highlights;
# *Dimmed is blended further still. Matches the stock theme's own luminance
# ordering (word brightest, dimmed close to the wash) at 0/0.65/0.85 depths.
_CLAUDE_DIFF_ROLES = {
    "diffAdded":       ("green", 0.65),
    "diffAddedWord":   ("green", 0.0),
    "diffAddedDimmed": ("green", 0.85),
    "diffRemoved":       ("red", 0.65),
    "diffRemovedWord":   ("red", 0.0),
    "diffRemovedDimmed": ("red", 0.85),
}

# Foreground-role tokens that must meet WCAG AA text contrast (4.5:1) against
# bg. Chrome/dim tokens (comment-derived, selection/background roles) are held
# to the UI-component bar (3:1) instead, matching WCAG 1.4.11. diffAdded/
# diffRemoved/*Dimmed are background washes, not text, and are exempt.
_CLAUDE_THEME_TEXT_TOKENS = {
    "text", "success", "error", "warning", "autoAccept", "skill", "merged",
    "effortUltra", "permission", "suggestion", "remember", "planMode",
    "background", "ide", "professionalBlue", "briefLabelYou", "bashBorder",
    "claude", "clawd_body", "briefLabelClaude", "fastMode", "chromeYellow",
    "diffAddedWord", "diffRemovedWord",
}
_CLAUDE_THEME_CHROME_TOKENS = {
    "inactive", "subtle", "promptBorder",
}


def _generate_claude_dracula_pro_theme(dp_dir: str, variant: str) -> str | None:
    """Generate a Claude Code custom theme JSON for a Dracula Pro variant.

    Written to ~/.claude/themes/<slug>.json and selected at runtime via the
    "theme": "custom:<slug>" setting (dot_claude/settings.json.tmpl branches on
    KOOPA_COLOR_MODE to pick dracula-pro vs dracula-pro-alucard). "base" carries
    any of Claude Code's ~72 tokens this mapping does not override.
    """
    p = _parse_vim_palette(dp_dir, variant)
    if not p:
        return None
    is_light = variant == "alucard"
    base = "light" if is_light else "dark"
    fg, bg = p["fg"], p["bg"]
    # Dracula Pro has no distinct indigo; split the difference between purple
    # and cyan so rainbow_indigo reads as a hue between its neighbors.
    indigo = _hex_lerp(p["purple"], p["cyan"], 0.5)
    roles = dict(p)
    roles["indigo"] = indigo

    def _shimmer(hexval: str) -> str:
        # Dark base: lighten toward white for a brighter accent. Light base
        # (Alucard): lightening collapses contrast against the pale bg, so
        # darken toward fg instead -- verified this keeps shimmer >= base
        # contrast in both variants.
        target = fg if is_light else "#FFFFFF"
        return _hex_lerp(hexval, target, 0.35)

    overrides: dict[str, str] = {}
    for token, spec in _CLAUDE_THEME_TOKEN_ROLES:
        if isinstance(spec, tuple):
            role, _ = spec
            overrides[token] = _shimmer(roles[role])
        else:
            overrides[token] = roles[spec]
    for token, (role, blend) in _CLAUDE_DIFF_ROLES.items():
        overrides[token] = _hex_lerp(roles[role], bg, blend)

    for token in _CLAUDE_THEME_TEXT_TOKENS:
        ratio = _contrast_ratio(overrides[token], bg)
        assert ratio >= 4.5, (
            f"[claude-theme:{variant}] {token} contrast {ratio:.2f}:1 < 4.5:1 AA"
        )
    for token in _CLAUDE_THEME_CHROME_TOKENS:
        ratio = _contrast_ratio(overrides[token], bg)
        assert ratio >= 3.0, (
            f"[claude-theme:{variant}] {token} contrast {ratio:.2f}:1 < 3.0:1 (chrome)"
        )

    theme = {
        "name": "Dracula Pro Alucard" if is_light else "Dracula Pro",
        "base": base,
        "overrides": overrides,
    }
    return json.dumps(theme, indent=2) + "\n"


# Obsidian's own "--color-base-NN" ramp step -> blend fraction from bg (0.0)
# toward fg (1.0). Obsidian derives most of its chrome from this ramp
# (--background-secondary from base-20, --text-muted from base-70, etc.), so
# generating the ramp covers far more UI than listing each semantic role by
# hand. bg itself is step "00" and fg is step "100" (added separately below).
_OBSIDIAN_RAMP_STEPS = {
    "05": 0.03, "10": 0.06, "20": 0.10, "25": 0.13, "30": 0.16, "35": 0.20,
    "40": 0.25, "50": 0.36, "60": 0.50, "70": 0.66,
}

# Stable emission order for the generated theme.css blocks.
_OBSIDIAN_VAR_ORDER = (
    "--color-base-00", "--color-base-05", "--color-base-10", "--color-base-20",
    "--color-base-25", "--color-base-30", "--color-base-35", "--color-base-40",
    "--color-base-50", "--color-base-60", "--color-base-70", "--color-base-100",
    "--color-accent", "--color-accent-1", "--color-accent-2",
    "--color-red", "--color-orange", "--color-yellow", "--color-green",
    "--color-cyan", "--color-purple", "--color-pink", "--color-blue",
    "--text-on-accent", "--text-selection",
)

# Contrast requirements checked against --color-base-00 (the mode's bg).
# --color-base-50 only backs --text-faint in Obsidian's own var() chain, so
# it gets a lower floor than the AA text tokens.
_OBSIDIAN_AA_TEXT_VARS = {
    "--color-base-70", "--color-base-100", "--color-accent",
    "--color-accent-1", "--color-accent-2", "--color-red", "--color-orange",
    "--color-yellow", "--color-green", "--color-cyan", "--color-purple",
    "--color-pink", "--color-blue",
}
_OBSIDIAN_FAINT_VARS = {"--color-base-50"}


def _obsidian_color_vars(dp_dir: str, variant: str) -> dict[str, str] | None:
    """Derive one mode's worth of Obsidian CSS variables from a Vim palette."""
    p = _parse_vim_palette(dp_dir, variant)
    if not p:
        return None
    bg, fg = p["bg"], p["fg"]
    accent = p["purple"]
    ramp: dict[str, str] = {"--color-base-00": bg, "--color-base-100": fg}
    for step, frac in _OBSIDIAN_RAMP_STEPS.items():
        ramp[f"--color-base-{step}"] = _hex_lerp(bg, fg, frac)
    ramp.update({
        "--color-accent": accent,
        # accent-1/accent-2 are Obsidian's own hover/secondary accent slots.
        "--color-accent-1": _hex_lerp(accent, fg, 0.20),
        "--color-accent-2": _hex_lerp(accent, p["pink"], 0.35),
        "--color-red": p["red"],
        "--color-orange": p["orange"],
        "--color-yellow": p["yellow"],
        "--color-green": p["green"],
        "--color-cyan": p["cyan"],
        "--color-purple": p["purple"],
        "--color-pink": p["pink"],
        # Dracula Pro has no distinct blue role; split the difference
        # between purple and cyan, same approach as the Claude theme's
        # synthesized indigo.
        "--color-blue": _hex_lerp(p["purple"], p["cyan"], 0.5),
        # bg on the accent clears AA in every variant; fg on the accent does
        # not (measured 2.89:1 pro / 2.64:1 alucard, both below 4.5:1).
        "--text-on-accent": bg,
        "--text-selection": p["selection"],
    })
    return ramp


def _assert_obsidian_contrast(v: dict[str, str], variant: str) -> None:
    """Check WCAG contrast for one mode's Obsidian variable set."""
    bg = v["--color-base-00"]
    for token in _OBSIDIAN_AA_TEXT_VARS:
        ratio = _contrast_ratio(v[token], bg)
        assert ratio >= 4.5, (
            f"[obsidian-theme:{variant}] {token} contrast {ratio:.2f}:1 < 4.5:1 AA"
        )
    for token in _OBSIDIAN_FAINT_VARS:
        ratio = _contrast_ratio(v[token], bg)
        assert ratio >= 2.0, (
            f"[obsidian-theme:{variant}] {token} contrast {ratio:.2f}:1 < 2.0:1"
        )
    on_accent_ratio = _contrast_ratio(v["--text-on-accent"], v["--color-accent"])
    assert on_accent_ratio >= 4.5, (
        f"[obsidian-theme:{variant}] --text-on-accent vs --color-accent "
        f"contrast {on_accent_ratio:.2f}:1 < 4.5:1 AA"
    )
    # The ramp is built by blending bg toward fg with an increasing fraction,
    # so its luminance must move monotonically from bg to fg. This is the
    # guard against a variant where the named Vim ramp roles (bglight, etc.)
    # don't move consistently -- Alucard's bglight equals its bg exactly --
    # in case a future edit ever swaps the lerp for one of those named roles.
    order = (
        "00", "05", "10", "20", "25", "30", "35", "40", "50", "60", "70", "100"
    )
    lums = [_wcag_relative_luminance(v[f"--color-base-{step}"]) for step in order]
    direction = 1 if lums[-1] > lums[0] else -1
    for i in range(len(lums) - 1):
        assert (lums[i + 1] - lums[i]) * direction >= -1e-9, (
            f"[obsidian-theme:{variant}] base ramp not monotone at step {order[i + 1]}"
        )


def _generate_obsidian_dracula_pro_theme(dp_dir: str, dark_variant: str) -> str | None:
    """Generate one Obsidian theme.css with real dark and light mode blocks.

    Unlike every other Dracula Pro consumer in this file, Obsidian already
    has a native Base color scheme toggle (Settings > Appearance), so a
    single file with a genuine ``.theme-dark`` block (dark_variant) and a
    genuine ``.theme-light`` block (always alucard) covers both modes --
    no KOOPA_COLOR_MODE branching needed on the Obsidian side.
    """
    dark_vars = _obsidian_color_vars(dp_dir, dark_variant)
    light_vars = _obsidian_color_vars(dp_dir, "alucard")
    if not dark_vars or not light_vars:
        return None
    _assert_obsidian_contrast(dark_vars, dark_variant)
    _assert_obsidian_contrast(light_vars, "alucard")
    lines = [
        "/* Generated by koopa from the user's local Dracula Pro assets. */",
        "/* Do not edit by hand -- see install:_generate_obsidian_dracula_pro_theme. */",
        "",
        ".theme-dark {",
    ]
    lines += [f"    {key}: {dark_vars[key]};" for key in _OBSIDIAN_VAR_ORDER]
    lines += ["}", "", ".theme-light {"]
    lines += [f"    {key}: {light_vars[key]};" for key in _OBSIDIAN_VAR_ORDER]
    lines += ["}", ""]
    return "\n".join(lines)


def _generate_obsidian_manifest() -> str:
    """Generate a minimal, honest Obsidian theme manifest.

    Not a vendor or "official" claim -- this is a derived, unofficial port
    generated from the user's own paid Dracula Pro palette.
    """
    manifest = {
        "name": "Dracula Pro",
        "version": "1.0.0",
        "minAppVersion": "1.0.0",
        "author": "koopa (unofficial; generated from a local Dracula Pro license)",
    }
    return json.dumps(manifest, indent=2) + "\n"


def _obsidian_vault_dirs(home: str) -> list[str]:
    """Return the .obsidian dir of every vault registered with Obsidian.app.

    Obsidian themes are per-vault, not a single fixed config dir like every
    other app this pattern touches, so resolve every vault from Obsidian's
    own registry file instead of assuming one path.
    """
    if is_macos():
        registry = os.path.join(
            home, "Library", "Application Support", "obsidian", "obsidian.json"
        )
    else:
        registry = os.path.join(xdg_config_home(), "obsidian", "obsidian.json")
    if not os.path.isfile(registry):
        return []
    try:
        with open(registry) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return []
    vaults = data.get("vaults") if isinstance(data, dict) else None
    if not isinstance(vaults, dict):
        return []
    dirs = []
    for entry in vaults.values():
        if not isinstance(entry, dict):
            continue
        path = entry.get("path")
        if not isinstance(path, str):
            continue
        obsidian_dir = os.path.join(path, ".obsidian")
        if os.path.isdir(obsidian_dir):
            dirs.append(obsidian_dir)
    return dirs


def _wcag_relative_luminance(hexcolor: str) -> float:
    """True WCAG relative luminance, with sRGB gamma decoding.

    _relative_luminance() above skips gamma decoding (it's a cheap "is this
    background light enough" heuristic for the JetBrains synthesis check),
    which understates the luminance of saturated colors and gives contrast
    ratios that are too low. Contrast-ratio assertions need the real formula.
    """
    def _channel(c: float) -> float:
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4

    r = _channel(int(hexcolor[1:3], 16) / 255)
    g = _channel(int(hexcolor[3:5], 16) / 255)
    b = _channel(int(hexcolor[5:7], 16) / 255)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def _contrast_ratio(hex_a: str, hex_b: str) -> float:
    """WCAG contrast ratio between two hex colors."""
    lum_a, lum_b = _wcag_relative_luminance(hex_a), _wcag_relative_luminance(hex_b)
    hi, lo = max(lum_a, lum_b), min(lum_a, lum_b)
    return (hi + 0.05) / (lo + 0.05)


def _tmtheme_colors(dp_dir: str, variant: str) -> dict[str, str] | None:
    """Parse key colors from a Dracula Pro .tmTheme for the given variant."""
    name_map = {
        "pro": "Dracula Pro.tmTheme",
        "blade": "Dracula Pro (Blade).tmTheme",
        "buffy": "Dracula Pro (Buffy).tmTheme",
        "lincoln": "Dracula Pro (Lincoln).tmTheme",
        "morbius": "Dracula Pro (Morbius).tmTheme",
        "van-helsing": "Dracula Pro (Van Helsing).tmTheme",
        "alucard": "Dracula Pro (Alucard).tmTheme",
    }
    fname = name_map.get(variant, "Dracula Pro.tmTheme")
    path = os.path.join(dp_dir, "themes", "sublime", fname)
    if not os.path.isfile(path):
        return None
    with open(path, "rb") as fh:
        data = plistlib.load(fh)
    global_s = data["settings"][0]["settings"]
    scope_map: dict[str, str] = {}
    for item in data["settings"][1:]:
        fg = item.get("settings", {}).get("foreground", "")
        if not fg:
            continue
        for scope in item.get("scope", "").split(","):
            scope_map[scope.strip()] = fg
    return {
        "background":    global_s.get("background", "#282a36"),
        "foreground":    global_s.get("foreground", "#f8f8f2"),
        "selection":     global_s.get("selection", "#44475a"),
        "line_highlight": global_s.get("lineHighlight", "#44475a"),
        "comment":       scope_map.get("comment", "#6272a4"),
        "string":        scope_map.get("string", "#f1fa8c"),
        "number":        scope_map.get("constant.numeric", "#bd93f9"),
        "keyword":       scope_map.get("keyword", "#ff79c6"),
        "function":      scope_map.get("entity.name.function", "#50fa7b"),
        "type":          scope_map.get("storage.type", "#8be9fd"),
        "variable":      scope_map.get("variable.parameter", "#ffb86c"),
        "is_dark":       global_s.get("background", "#282a36")[1:3].lower() < "80",
        "red":           scope_map.get("message.error", "#ff5555"),
    }


# Free Dracula color → CSS property role mapping used for substitution.
# Each entry is (free_hex, role_key) in lowercase for case-insensitive matching.
_FREE_DRACULA_COLOR_MAP = [
    ("#282a36", "background"),
    ("#21222c", "background"),    # slightly darker bg variant
    ("#6272a4", "comment"),
    ("#50fa7b", "function"),
    ("#f1fa8c", "string"),
    ("#ff79c6", "keyword"),
    ("#bd93f9", "number"),
    ("#8be9fd", "type"),
    ("#ffb86c", "variable"),
]


def _generate_rstudio_rstheme(
    dp_dir: str,
    variant: str,
    template_path: str,
) -> str | None:
    """Generate an .rstheme CSS by replacing free Dracula colors with Pro colors."""
    colors = _tmtheme_colors(dp_dir, variant)
    if not colors:
        return None
    with open(template_path) as fh:
        css = fh.read()
    # Strip the old theme name header and replace with Pro name.
    variant_display_map = {
        "pro": "Dracula Pro",
        "blade": "Dracula Pro Blade",
        "buffy": "Dracula Pro Buffy",
        "lincoln": "Dracula Pro Lincoln",
        "morbius": "Dracula Pro Morbius",
        "van-helsing": "Dracula Pro Van Helsing",
        "alucard": "Dracula Pro Alucard",
    }
    display_name = variant_display_map.get(variant, "Dracula Pro")
    is_dark = "TRUE" if colors["is_dark"] else "FALSE"
    css = re.sub(
        r'/\* rs-theme-name:.*?\*/',
        f'/* rs-theme-name: {display_name} */',
        css,
    )
    css = re.sub(
        r'/\* rs-theme-is-dark:.*?\*/',
        f'/* rs-theme-is-dark: {is_dark} */',
        css,
    )
    # Substitute each free Dracula color with the Pro equivalent.
    role_to_pro = {
        "background": colors["background"],
        "comment":    colors["comment"],
        "function":   colors["function"],
        "string":     colors["string"],
        "keyword":    colors["keyword"],
        "number":     colors["number"],
        "type":       colors["type"],
        "variable":   colors["variable"],
    }
    color_map = list(_FREE_DRACULA_COLOR_MAP)
    # Light variants (e.g. Alucard): the dark template's UI-chrome colors and
    # ANSI base palette must also be remapped; dark variants are unchanged.
    if not colors["is_dark"]:
        bg = colors["background"]
        fg = colors["foreground"]
        muted = _hex_lerp(fg, bg, 0.45)
        role_to_pro.update({
            "foreground": fg,
            "panel_bg":   _hex_lerp(bg, "#000000", 0.06),
            "deep_bg":    _hex_lerp(bg, "#000000", 0.12),
            "hover_bg":   _hex_lerp(bg, "#000000", 0.10),
            "border":     _hex_lerp(bg, fg, 0.18),
            "selection":  colors["selection"],
            "muted":      muted,
        })
        color_map += [
            ("#f8f8f2", "foreground"),
            ("#252631", "panel_bg"),
            ("#1a1b22", "deep_bg"),
            ("#32343f", "hover_bg"),
            ("#303140", "border"),
            ("#464b5d", "selection"),   # alpha suffix (#464B5D80) preserved by re.sub
            ("#adb5cb", "muted"),
            ("#4b5578", "muted"),
        ]
        # Remap ANSI base palette (indices 0-15 only; 16-255 are the standard
        # xterm color cube — protocol-literal, must not be changed).
        ansi = _parse_ghostty_palette(dp_dir, "alucard")
        if ansi:
            tango_to_alucard = [
                ("#2e3436", ansi["black"]),           # 0
                ("#cc0000", ansi["red"]),              # 1
                ("#4e9a06", ansi["green"]),            # 2
                ("#c4a000", ansi["yellow"]),           # 3
                ("#3465a4", ansi["blue"]),             # 4
                ("#75507b", ansi["magenta"]),          # 5
                ("#06989a", ansi["cyan"]),             # 6
                ("#d3d7cf", ansi["foreground"]),       # 7 (ANSI white → palette fg)
                ("#555753", ansi["comment"]),          # 8 (raw slot too low-contrast)
                ("#ef2929", ansi["red_bright"]),       # 9
                ("#8ae234", ansi["green_bright"]),     # 10
                ("#fce94f", ansi["yellow_bright"]),    # 11
                ("#729fcf", ansi["blue_bright"]),      # 12
                ("#ad7fa8", ansi["magenta_bright"]),   # 13
                ("#34e2e2", ansi["cyan_bright"]),      # 14
                ("#eeeeec", ansi["foreground"]),       # 15 (bright white → palette fg)
            ]
            for free_hex, pro_hex in tango_to_alucard:
                css = re.sub(re.escape(free_hex), pro_hex, css, flags=re.IGNORECASE)
    for free_hex, role in color_map:
        pro_hex = role_to_pro.get(role, free_hex)
        css = re.sub(re.escape(free_hex), pro_hex, css, flags=re.IGNORECASE)
    return css


def _hex_lerp(c1: str, c2: str, t: float) -> str:
    """Linearly interpolate between two hex colors."""
    r1, g1, b1 = int(c1[1:3], 16), int(c1[3:5], 16), int(c1[5:7], 16)
    r2, g2, b2 = int(c2[1:3], 16), int(c2[3:5], 16), int(c2[5:7], 16)
    r = int(r1 + (r2 - r1) * t)
    g = int(g1 + (g2 - g1) * t)
    b = int(b1 + (b2 - b1) * t)
    return f"#{r:02X}{g:02X}{b:02X}"


def _relative_luminance(hexcolor: str) -> float:
    r = int(hexcolor[1:3], 16) / 255
    g = int(hexcolor[3:5], 16) / 255
    b = int(hexcolor[5:7], 16) / 255
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def _hex_to_hls(hexcolor: str) -> tuple[float, float, float]:
    r = int(hexcolor[1:3], 16) / 255
    g = int(hexcolor[3:5], 16) / 255
    b = int(hexcolor[5:7], 16) / 255
    return colorsys.rgb_to_hls(r, g, b)


def _lightify_hex(hexcolor: str) -> str:
    """Luminance-flip a dark hex to a pale light equivalent (no literals)."""
    h, lum, s = _hex_to_hls(hexcolor)
    lum_light = max(0.88, 1.0 - lum * 0.25)
    s_light = min(s * 0.35, 0.18)
    r, g, b = colorsys.hls_to_rgb(h, lum_light, s_light)
    return f"#{int(r * 255):02X}{int(g * 255):02X}{int(b * 255):02X}"


def _darken_for_light_bg(hexcolor: str, bg: str = "#fafafa", min_ratio: float = 3.0) -> str:
    """Invert a dark-theme foreground hex to a legible light-background hue.

    Preserves hue and saturation; binary-searches HLS lightness until contrast
    against ``bg`` clears ``min_ratio``. A fixed HLS-lightness constant is not
    safe here -- WCAG luminance and HLS lightness diverge sharply for
    green/yellow hues, so a naive inversion still leaves some hues unreadable.
    This is the foreground counterpart to _lightify_hex(): that one always
    pales toward white, which is correct for background roles but wrong for
    text.
    """
    h, _, s = _hex_to_hls(hexcolor)
    s_light = min(s * 1.1, 0.9) if s > 0 else 0.0
    lo, hi = 0.0, 1.0
    for _ in range(24):
        mid = (lo + hi) / 2
        r, g, b = colorsys.hls_to_rgb(h, mid, s_light)
        candidate = f"#{int(r * 255):02X}{int(g * 255):02X}{int(b * 255):02X}"
        if _contrast_ratio(candidate, bg) >= min_ratio:
            lo = mid
        else:
            hi = mid
    r, g, b = colorsys.hls_to_rgb(h, lo, s_light)
    return f"#{int(r * 255):02X}{int(g * 255):02X}{int(b * 255):02X}"


def _nudge_hue_toward(hexcolor: str, target_hex: str, min_hue_deg: float) -> str:
    """Blend hexcolor toward target_hex only as far as needed to clear a hue floor.

    Dracula Pro Alucard's "orange" role has a hue of about 24 degrees -- closer
    to red (0 degrees) than to a hue most people would call orange (30-40
    degrees). It's the vendor's own value (confirmed identical in the Fleet
    experimental palette), not a koopa derivation bug, but it reads as "red"
    when used for a role meant to signal "not red." Blending toward the
    palette's own yellow (a real, verified color, never an invented literal)
    raises the hue without inventing a new one. A no-op when the input
    already clears the floor (Pro's orange is already hue ~35, untouched).
    """
    def _hue(hx: str) -> float:
        h, _, _ = _hex_to_hls(hx)
        return h * 360

    if _hue(hexcolor) >= min_hue_deg:
        return hexcolor
    lo, hi = 0.0, 1.0
    for _ in range(30):
        mid = (lo + hi) / 2
        if _hue(_hex_lerp(hexcolor, target_hex, mid)) < min_hue_deg:
            lo = mid
        else:
            hi = mid
    return _hex_lerp(hexcolor, target_hex, hi)


def _parse_fleet_palette(dp_dir: str, variant: str) -> dict[str, str] | None:
    """Parse the NAME:HEX palette block from a Fleet experimental theme JSON."""
    fname = "dracula-pro.json" if variant == "pro" else f"dracula-pro_{variant}.json"
    path = os.path.join(
        dp_dir, "themes", "jetbrains", "experimental", "fleet", fname
    )
    if not os.path.isfile(path):
        return None
    with open(path) as fh:
        data = json.load(fh)
    pal = data.get("palette")
    if not pal:
        return None
    return {k: v.lower() for k, v in pal.items()}


def _generate_bbedit_dracula_pro(dp_dir: str, variant: str) -> str | None:
    """Generate a .bbColorScheme plist XML for a Dracula Pro variant."""
    colors = _tmtheme_colors(dp_dir, variant)
    if not colors:
        return None
    bg = colors["background"]
    fg = colors["foreground"]
    sel = colors["selection"]
    line_hl = colors["line_highlight"]
    if colors["is_dark"] and sel.lower() == line_hl.lower():
        line_hl = _hex_lerp(bg, sel, 0.40)
        secondary_sel = sel
        sel = _hex_lerp(bg, sel, 1.70)
        highlight_insertion_point = True
    else:
        secondary_sel = sel
        highlight_insertion_point = bool(colors["is_dark"])
    comment = colors["comment"]
    string = colors["string"]
    number = colors["number"]
    keyword = colors["keyword"]
    func = colors["function"]
    typ = colors["type"]
    variable = colors["variable"]
    red = colors.get("red", "#ff5555")
    variant_display_map = {
        "pro": "Dracula Pro",
        "blade": "Dracula Pro Blade",
        "buffy": "Dracula Pro Buffy",
        "lincoln": "Dracula Pro Lincoln",
        "morbius": "Dracula Pro Morbius",
        "van-helsing": "Dracula Pro Van Helsing",
        "alucard": "Dracula Pro Alucard",
    }
    display_name = variant_display_map.get(variant, "Dracula Pro")
    return f"""\
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
\t<key>BBEditDocumentType</key>
\t<string>ColorScheme</string>
\t<key>BackgroundColor</key>
\t<string>{bg}</string>
\t<key>ColorSchemeFormatVersion</key>
\t<integer>3</integer>
\t<key>DifferenceHighlightColor</key>
\t<string>{func}</string>
\t<key>HighlightInsertionPoint</key>
\t<{"true" if highlight_insertion_point else "false"}/>
\t<key>InsertionPointLineHighlightColor</key>
\t<string>{line_hl}</string>
\t<key>InvisibleOthersColor</key>
\t<string>{comment}</string>
\t<key>InvisibleSpacesColor</key>
\t<string>{comment}</string>
\t<key>PrimaryHighlightColor</key>
\t<string>{sel}</string>
\t<key>SecondaryHighlightColor</key>
\t<string>{secondary_sel}</string>
\t<key>SpellingColor</key>
\t<string>{red}</string>
\t<key>UseCustomHighlightColor</key>
\t<true/>
\t<key>com.barebones.bblm.JavaScript.regexp</key>
\t<string>{string}</string>
\t<key>com.barebones.bblm.Pyth.decorator</key>
\t<string>{variable}</string>
\t<key>com.barebones.bblm.Pyth.triple-string</key>
\t<string>{string}</string>
\t<key>com.barebones.bblm.TeX.math-string</key>
\t<string>{string}</string>
\t<key>com.barebones.bblm.TeX.param-content</key>
\t<string>{variable}</string>
\t<key>com.barebones.bblm.TeX.verbatim</key>
\t<string>{typ}</string>
\t<key>com.barebones.bblm.code</key>
\t<string>{fg}</string>
\t<key>com.barebones.bblm.comment</key>
\t<string>{comment}</string>
\t<key>com.barebones.bblm.css.color-spec</key>
